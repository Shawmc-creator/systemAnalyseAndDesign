        },
        {
          "name": "result_kind",
          "type": "TEXT",
          "nullable": true,
          "description": "受控结果对象类别",
          "source": "Q-03、Q-05、Q-07"
        },
        {
          "name": "result_key",
          "type": "TEXT",
          "nullable": true,
          "description": "结果对象编号或主键",
          "source": "Q-03、Q-05、Q-07"
        },
        {
          "name": "result_revision",
          "type": "INTEGER",
          "nullable": true,
          "description": "该阶段结果版本",
          "source": "Q-03、Q-05、Q-07"
        },
        {
          "name": "result_code",
          "type": "TEXT",
          "nullable": true,
          "description": "稳定结果码；不能把业务待核实写成退款成功",
          "source": "Q-03、Q-05、Q-07"
        },
        {
          "name": "correlation_id",
          "type": "TEXT",
          "nullable": false,
          "description": "请求关联号",
          "source": "Q-03、Q-05、Q-07"
        }
      ],
      "constraints": [
        "UNIQUE(account_id,request_key)；同键异操作/异摘要拒绝，不能覆盖旧结果。",
        "在同一写事务中检查幂等键、执行业务、保存结果及审计后提交；不允许提交处理中行。失败整体回滚，再独立记录失败事件。",
        "重试返回原阶段办理号及原结果，重新核验当前权限后可另查最新状态；付款/退款结果未知保存在业务表，不等于本地事务未提交。",
        "外部核验不在数据库写锁内等待；先持久化待办理事实，再以新的命令登记核实结果。结果字段只作白名单定位，业务完整性由业务外键保证。"
      ],
      "operations": [
        "识别重复命令",
        "返回原阶段结果"
      ]
