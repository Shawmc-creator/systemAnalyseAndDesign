{
  "version": "2026-10-17-D1-support",
  "tables": [
    {
      "key": "user_account",
      "table": "user_account",
      "name": "职员账号",
      "source": "Q-01、Q-02",
      "reason": "职员与登录身份分开，保留账号及停用历史。",
      "fields": [
        {
          "name": "id",
          "type": "INTEGER",
          "nullable": false,
          "description": "稳定内部主键；PK。",
          "primary_key": true,
          "source": "Q-01、Q-02"
        },
        {
          "name": "staff_id",
          "type": "INTEGER",
          "nullable": false,
          "description": "所属职员；唯一；引用staff.id。",
          "source": "Q-01、Q-02",
          "foreign_key": "staff",
          "unique": true
        },
        {
          "name": "login_name",
          "type": "TEXT",
          "nullable": false,
          "description": "规范化小写登录名；唯一，3至64位允许字符",
          "source": "Q-01、Q-02",
          "unique": true
        },
        {
          "name": "password_hash",
          "type": "TEXT",
          "nullable": false,
          "description": "含算法、盐和参数的慢哈希编码；不保存原口令",
          "source": "Q-01、Q-02"
        },
        {
          "name": "status",
          "type": "TEXT",
          "nullable": false,
          "description": "启用或停用；首次显式指定",
          "source": "Q-01、Q-02"
        },
        {
          "name": "auth_version",
          "type": "INTEGER",
          "nullable": false,
          "description": "授权/凭据版本；正整数，默认1",
          "source": "Q-01、Q-02"
        },
        {
          "name": "password_changed_at",
          "type": "TEXT",
          "nullable": false,
          "description": "最近凭据变更时刻",
          "source": "Q-01、Q-02"
        },
        {
          "name": "created_at",
          "type": "TEXT",
          "nullable": false,
          "description": "账号建立时刻",
          "source": "Q-01、Q-02"
        },
        {
          "name": "updated_at",
          "type": "TEXT",
          "nullable": false,
          "description": "最近变更时刻",
          "source": "Q-01、Q-02"
        },
        {
          "name": "disabled_at",
          "type": "TEXT",
          "nullable": true,
          "description": "停用时刻；启用时可空",
          "source": "Q-01、Q-02"
        },
        {
          "name": "disabled_reason",
          "type": "TEXT",
          "nullable": true,
          "description": "停用依据；停用时必填",
          "source": "Q-01、Q-02"
        },
        {
          "name": "revision",
          "type": "INTEGER",
          "nullable": false,
          "description": "并发版本；默认1",
          "source": "Q-01、Q-02"
        }
      ],
      "constraints": [
        "staff_id和login_name分别唯一；一个职员一个个人账号，不共享账号。",
        "停用、口令更换或任一有效授权变化递增auth_version，与相关变更和审计同事务。禁止删除历史账号。",
        "首名负责人经受控初始化创建，绑定既有职员并记录初始化审计；初始化入口在完成后关闭。"
      ],
      "operations": [
        "核验身份",
        "停用并失效会话"
      ]
    },
    {
      "key": "access_role",
      "table": "access_role",
      "name": "访问角色",
      "source": "Q-01",
      "reason": "固定五类岗位身份，不以负责人身份推导全部临床权限。",
      "fields": [
        {
          "name": "id",
          "type": "INTEGER",
          "nullable": false,
          "description": "稳定内部主键；PK。",
          "primary_key": true,
          "source": "Q-01"
        },
        {
          "name": "code",
          "type": "TEXT",
          "nullable": false,
          "description": "唯一代码：frontdesk、dentist、cashier、assistant、manager",
          "source": "Q-01",
          "unique": true
        },
        {
          "name": "name",
          "type": "TEXT",
          "nullable": false,
          "description": "固定岗位名称",
          "source": "Q-01"
        },
        {
          "name": "description",
          "type": "TEXT",
          "nullable": false,
          "description": "岗位职责说明",
          "source": "Q-01"
        },
        {
          "name": "created_at",
          "type": "TEXT",
          "nullable": false,
          "description": "固定配置建立时刻",
          "source": "Q-01"
        }
      ],
      "constraints": [
        "五种角色与B规约执行者一致；固定代码不可改成新的业务角色。",
        "职员岗位资格和账号获授访问角色同时有效，才允许使用该角色权限。"
      ],
      "operations": [
        "取得岗位定义"
      ]
    },
    {
      "key": "access_permission",
      "table": "access_permission",
      "name": "操作权限",
      "source": "Q-01、Q-05",
      "reason": "把多人参与用例拆成具体操作，避免一项权限同时授予录入与审核。",
      "fields": [
        {
          "name": "id",
          "type": "INTEGER",
          "nullable": false,
          "description": "稳定内部主键；PK。",
          "primary_key": true,
          "source": "Q-01、Q-05"
        },
        {
          "name": "code",
          "type": "TEXT",
          "nullable": false,
          "description": "唯一操作代码，最长64字符",
          "source": "Q-01、Q-05",
          "unique": true
        },
        {
          "name": "usecase_no",
          "type": "TEXT",
          "nullable": true,
          "description": "UC-01至UC-32；运行管理权限为空",
          "source": "Q-01、Q-05"
        },
        {
          "name": "name",
          "type": "TEXT",
          "nullable": false,
          "description": "操作含义",
          "source": "Q-01、Q-05"
        },
        {
          "name": "operation_kind",
          "type": "TEXT",
          "nullable": false,
          "description": "查询、业务写入或运行管理",
          "source": "Q-01、Q-05"
        },
        {
          "name": "object_rule",
          "type": "TEXT",
          "nullable": false,
          "description": "必须执行的对象范围规则标识",
          "source": "Q-01、Q-05"
        },
        {
          "name": "config_version",
          "type": "INTEGER",
          "nullable": false,
          "description": "固定权限配置版本；正整数",
          "source": "Q-01、Q-05"
        }
      ],
      "constraints": [
        "权限由受控配置发布；不是用户输入的表名或SQL。",
        "查询权限不包含相应用例的变更权限。对象范围与岗位权限取交集，不能只检查菜单可见。"
      ],
      "operations": [
        "匹配具体操作",
        "取得对象规则"
      ]
    },
    {
      "key": "staff_role_qualification",
      "table": "staff_role_qualification",
      "name": "职员岗位资格",
      "source": "Q-01；C职员职责",
      "reason": "保留职员可承担岗位的有效区间及核实依据，支撑接诊、审核和放行责任。",
      "fields": [
        {
          "name": "id",
          "type": "INTEGER",
          "nullable": false,
          "description": "稳定内部主键；PK。",
          "primary_key": true,
          "source": "Q-01；C职员职责"
        },
        {
          "name": "staff_id",
          "type": "INTEGER",
          "nullable": false,
          "description": "资格所属职员；引用staff.id。",
          "source": "Q-01；C职员职责",
          "foreign_key": "staff"
        },
        {
          "name": "role_id",
          "type": "INTEGER",
          "nullable": false,
          "description": "具备资格的岗位；引用access_role.id。",
          "source": "Q-01；C职员职责",
          "foreign_key": "access_role"
        },
        {
          "name": "valid_from",
          "type": "TEXT",
          "nullable": false,
          "description": "资格生效时刻",
          "source": "Q-01；C职员职责"
        },
        {
          "name": "valid_until",
          "type": "TEXT",
          "nullable": true,
          "description": "资格截止；为空尚未届满",
          "source": "Q-01；C职员职责"
        },
        {
          "name": "verified_by",
          "type": "INTEGER",
          "nullable": false,
          "description": "核实负责人；初始化时为被核实的首名负责人；引用staff.id。",
          "source": "Q-01；C职员职责",
          "foreign_key": "staff"
        },
        {
          "name": "verification_basis",
          "type": "TEXT",
          "nullable": false,
          "description": "岗位任命或专业资格核实依据",
          "source": "Q-01；C职员职责"
        },
        {
          "name": "revoked_at",
          "type": "TEXT",
          "nullable": true,
          "description": "提前撤销时刻",
          "source": "Q-01；C职员职责"
        },
        {
          "name": "revoked_by",
          "type": "INTEGER",
          "nullable": true,
          "description": "撤销责任人；与撤销时间同时存在；引用staff.id。",
          "source": "Q-01；C职员职责",
          "foreign_key": "staff"
        },
        {
          "name": "revocation_reason",
          "type": "TEXT",
          "nullable": true,
          "description": "提前撤销原因",
          "source": "Q-01；C职员职责"
        },
        {
          "name": "created_at",
          "type": "TEXT",
          "nullable": false,
          "description": "资格记录建立时刻",
          "source": "Q-01；C职员职责"
        }
      ],
      "constraints": [
        "同职员同角色的有效区间不得重叠；截止晚于开始，撤销三项成组。",
        "重新任职新增经历，不复活旧资格行。资格失效时同步撤销不再满足条件的账号角色并使旧会话失效。",
        "业务提交和查询每次检查当前日期与在岗区间，不能依赖定时任务及时停用。"
      ],
      "operations": [
        "核实岗位资格",
        "撤销资格"
      ]
    },
    {
      "key": "account_role",
      "table": "account_role",
      "name": "账号角色授权",
      "source": "Q-01、Q-02",
      "reason": "记录谁在何时因何依据向账号授予岗位角色。",
      "fields": [
        {
          "name": "id",
          "type": "INTEGER",
          "nullable": false,
          "description": "稳定内部主键；PK。",
          "primary_key": true,
          "source": "Q-01、Q-02"
        },
        {
          "name": "account_id",
          "type": "INTEGER",
          "nullable": false,
          "description": "获得角色的账号；引用user_account.id。",
          "source": "Q-01、Q-02",
          "foreign_key": "user_account"
        },
        {
          "name": "role_id",
          "type": "INTEGER",
          "nullable": false,
          "description": "获授角色；引用access_role.id。",
          "source": "Q-01、Q-02",
          "foreign_key": "access_role"
        },
        {
          "name": "qualification_id",
          "type": "INTEGER",
          "nullable": false,
          "description": "同职员同角色的有效资格；引用staff_role_qualification.id。",
          "source": "Q-01、Q-02",
          "foreign_key": "staff_role_qualification"
        },
        {
          "name": "granted_by",
          "type": "INTEGER",
          "nullable": false,
          "description": "授予负责人账号；初始化可为首名负责人自身；引用user_account.id。",
          "source": "Q-01、Q-02",
          "foreign_key": "user_account"
        },
        {
          "name": "granted_at",
          "type": "TEXT",
          "nullable": false,
          "description": "授予时刻",
          "source": "Q-01、Q-02"
        },
        {
          "name": "valid_until",
          "type": "TEXT",
          "nullable": true,
          "description": "截止；不得超出资格有效区间",
          "source": "Q-01、Q-02"
        },
        {
          "name": "grant_reason",
          "type": "TEXT",
          "nullable": false,
          "description": "授权依据",
          "source": "Q-01、Q-02"
        },
        {
          "name": "revoked_by",
          "type": "INTEGER",
          "nullable": true,
          "description": "撤销账号；引用user_account.id。",
          "source": "Q-01、Q-02",
          "foreign_key": "user_account"
        },
        {
          "name": "revoked_at",
          "type": "TEXT",
          "nullable": true,
          "description": "撤销时刻",
          "source": "Q-01、Q-02"
        },
        {
          "name": "revocation_reason",
          "type": "TEXT",
          "nullable": true,
          "description": "撤销原因",
          "source": "Q-01、Q-02"
        }
      ],
      "constraints": [
        "同账号同角色最多一条未撤销且仍有效的授权；历史再次授予新增行。",
        "资格职员必须等于账号职员，角色也一致；授予人须有运行授权权限。撤销与auth_version递增、审计整体提交。"
      ],
      "operations": [
        "授予角色",
        "撤销角色"
      ]
    },
    {
      "key": "role_permission",
      "table": "role_permission",
      "name": "角色操作授权",
      "source": "Q-01",
      "reason": "固定岗位与细分操作的授权关联。",
      "fields": [
        {
          "name": "id",
          "type": "INTEGER",
          "nullable": false,
          "description": "稳定内部主键；PK。",
          "primary_key": true,
          "source": "Q-01"
        },
        {
          "name": "role_id",
          "type": "INTEGER",
          "nullable": false,
          "description": "岗位角色；引用access_role.id。",
          "source": "Q-01",
          "foreign_key": "access_role"
        },
        {
          "name": "permission_id",
          "type": "INTEGER",
          "nullable": false,
          "description": "允许的具体操作；引用access_permission.id。",
          "source": "Q-01",
          "foreign_key": "access_permission"
        },
        {
          "name": "config_version",
          "type": "INTEGER",
          "nullable": false,
          "description": "配置版本",
          "source": "Q-01"
        },
        {
          "name": "created_at",
          "type": "TEXT",
          "nullable": false,
          "description": "配置写入时刻",
          "source": "Q-01"
        }
      ],
      "constraints": [
        "UNIQUE(role_id,permission_id)。按本节权限矩阵初始化，配置升级保留审计与版本并使受影响会话失效。",
        "固定配置不提供随意扩大临床范围的网页开关。"
      ],
      "operations": [
        "判断岗位可执行操作"
      ]
    },
    {
      "key": "login_session",
      "table": "login_session",
      "name": "登录会话",
      "source": "Q-01、Q-05",
      "reason": "服务端验证身份、有效期与授权版本。",
      "fields": [
        {
          "name": "id",
          "type": "INTEGER",
          "nullable": false,
          "description": "稳定内部主键；PK。",
          "primary_key": true,
          "source": "Q-01、Q-05"
        },
        {
          "name": "account_id",
          "type": "INTEGER",
          "nullable": false,
          "description": "登录账号；引用user_account.id。",
          "source": "Q-01、Q-05",
          "foreign_key": "user_account"
        },
        {
          "name": "token_hash",
          "type": "TEXT",
          "nullable": false,
          "description": "高熵随机会话令牌的摘要；唯一，不存原令牌",
          "source": "Q-01、Q-05",
          "unique": true
        },
        {
          "name": "csrf_hash",
          "type": "TEXT",
          "nullable": false,
          "description": "会话绑定CSRF随机值摘要",
          "source": "Q-01、Q-05"
        },
        {
          "name": "auth_version",
          "type": "INTEGER",
          "nullable": false,
          "description": "登录时账号授权版本",
          "source": "Q-01、Q-05"
        },
        {
          "name": "runtime_epoch",
          "type": "TEXT",
          "nullable": false,
          "description": "本次服务运行代号；恢复或重新启动后变更",
          "source": "Q-01、Q-05"
        },
        {
          "name": "created_at",
          "type": "TEXT",
          "nullable": false,
          "description": "会话建立时刻",
          "source": "Q-01、Q-05"
        },
        {
          "name": "last_seen_at",
          "type": "TEXT",
          "nullable": false,
          "description": "最近有效活动时刻",
          "source": "Q-01、Q-05"
        },
        {
          "name": "expires_at",
          "type": "TEXT",
          "nullable": false,
          "description": "绝对到期时刻",
          "source": "Q-01、Q-05"
        },
        {
          "name": "revoked_at",
          "type": "TEXT",
          "nullable": true,
          "description": "注销或撤销时刻",
          "source": "Q-01、Q-05"
        },
        {
          "name": "revocation_reason",
          "type": "TEXT",
          "nullable": true,
          "description": "注销、停用、授权变更等原因",
          "source": "Q-01、Q-05"
        }
      ],
      "constraints": [
        "仅令牌摘要和版本一致、未撤销、账号及岗位有效且未超时才返回业务数据。",
        "沿用30分钟无活动、8小时绝对时限；每次请求服务端核验。重新登录轮换令牌，注销撤销服务端会话。",
        "运行代号来自启动环境的新随机值，不从恢复库复用；恢复旧数据不会使旧Cookie重新有效。会话Cookie采用HttpOnly、Secure及合适SameSite，状态改变验证CSRF。"
      ],
      "operations": [
        "核验会话",
        "撤销会话"
      ]
    },
    {
      "key": "authentication_event",
      "table": "authentication_event",
      "name": "身份验证事件",
      "source": "Q-01、Q-02",
      "reason": "记录已知或未知身份的成功、失败与注销，不为未知登录名创建职员。",
      "fields": [
        {
          "name": "id",
          "type": "INTEGER",
          "nullable": false,
          "description": "稳定内部主键；PK。",
          "primary_key": true,
          "source": "Q-01、Q-02"
        },
        {
          "name": "account_id",
          "type": "INTEGER",
          "nullable": true,
          "description": "已识别账号；未知为空；引用user_account.id。",
          "source": "Q-01、Q-02",
          "foreign_key": "user_account"
        },
        {
          "name": "session_id",
          "type": "INTEGER",
          "nullable": true,
          "description": "已建立的会话；失败可空；引用login_session.id。",
          "source": "Q-01、Q-02",
          "foreign_key": "login_session"
        },
        {
          "name": "event_type",
          "type": "TEXT",
          "nullable": false,
          "description": "成功、失败、注销、失效或限流",
          "source": "Q-01、Q-02"
        },
        {
          "name": "occurred_at",
          "type": "TEXT",
          "nullable": false,
          "description": "事件时刻",
          "source": "Q-01、Q-02"
        },
        {
          "name": "login_digest",
          "type": "TEXT",
          "nullable": false,
          "description": "规范化登录名的带密钥摘要",
          "source": "Q-01、Q-02"
        },
        {
          "name": "source_digest",
          "type": "TEXT",
          "nullable": false,
          "description": "来源地址的带密钥摘要；不保存口令",
          "source": "Q-01、Q-02"
        },
        {
          "name": "reason_code",
          "type": "TEXT",
          "nullable": false,
          "description": "受控原因码，不向外暴露账号是否存在",
          "source": "Q-01、Q-02"
        },
        {
          "name": "correlation_id",
          "type": "TEXT",
          "nullable": false,
          "description": "服务生成的请求关联号",
          "source": "Q-01、Q-02"
        }
      ],
      "constraints": [
        "只追加，事件不得保存原会话令牌、口令或请求正文。",
        "成功登录与会话记录同事务；失败事件单独提交。按登录摘要和来源共同限流，避免无限试错。摘要密钥单独受控保存。"
      ],
      "operations": [
