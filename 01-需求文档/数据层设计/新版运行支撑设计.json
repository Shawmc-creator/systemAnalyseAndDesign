        },
        {
          "name": "status",
          "type": "TEXT",
          "nullable": false,
          "description": "处理中或已提交；处理中只允许在未提交事务内存在",
          "source": "Q-03、Q-05、Q-07"
        },
        {
          "name": "created_at",
          "type": "TEXT",
          "nullable": false,
          "description": "本地处理开始时刻",
          "source": "Q-03、Q-05、Q-07"
        },
        {
          "name": "committed_at",
          "type": "TEXT",
          "nullable": true,
          "description": "提交前设置完成时刻；已提交必填",
