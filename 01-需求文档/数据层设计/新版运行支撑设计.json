          "source": "Q-04"
        },
        {
          "name": "verified_by",
          "type": "INTEGER",
          "nullable": true,
          "description": "手工核验账号；计划验证为空；引用user_account.id。",
          "source": "Q-04",
          "foreign_key": "user_account"
        },
        {
          "name": "error_code",
          "type": "TEXT",
          "nullable": true,
          "description": "复制失败原因",
          "source": "Q-04"
        }
      ],
      "constraints": [
        "UNIQUE(backup_id,location_kind,storage_key)；整份副本按清单逐项核验，不能只比较文件夹大小。",
        "保留最近30份成功备份及异机副本；只有可用性核对通过才执行轮换。删除文件后保留元数据、原因及审计，失败不得记已移除。"
      ],
      "operations": [
        "核验副本",
        "记录轮换"
      ]
    },
    {
      "key": "restore_verification",
      "table": "restore_verification",
      "name": "恢复验证",
      "source": "Q-04、Q-08",
      "reason": "每次验证一份特定备份副本，保留实际恢复时长和总结果。",
      "fields": [
        {
          "name": "id",
          "type": "INTEGER",
          "nullable": false,
          "description": "稳定内部主键；PK。",
          "primary_key": true,
          "source": "Q-04、Q-08"
        },
        {
          "name": "backup_id",
          "type": "INTEGER",
          "nullable": false,
          "description": "来源备份；引用backup_run.id。",
          "source": "Q-04、Q-08",
          "foreign_key": "backup_run"
        },
        {
          "name": "copy_id",
          "type": "INTEGER",
          "nullable": false,
          "description": "实际读取的已验证副本；引用backup_copy.id。",
          "source": "Q-04、Q-08",
          "foreign_key": "backup_copy"
        },
        {
          "name": "verified_by",
          "type": "INTEGER",
          "nullable": false,
          "description": "发起及负责验证的负责人账号；引用user_account.id。",
          "source": "Q-04、Q-08",
          "foreign_key": "user_account"
        },
        {
          "name": "trigger_kind",
          "type": "TEXT",
          "nullable": false,
          "description": "每月、升级前或故障恢复",
          "source": "Q-04、Q-08"
        },
        {
          "name": "status",
          "type": "TEXT",
          "nullable": false,
          "description": "待执行、运行中、通过或失败",
          "source": "Q-04、Q-08"
        },
        {
          "name": "isolated_path",
          "type": "TEXT",
          "nullable": false,
          "description": "经检查的隔离目录，不得为生产目录",
          "source": "Q-04、Q-08"
        },
        {
          "name": "started_at",
          "type": "TEXT",
          "nullable": true,
          "description": "实际开始时刻",
          "source": "Q-04、Q-08"
        },
        {
          "name": "finished_at",
          "type": "TEXT",
          "nullable": true,
          "description": "验证结束时刻",
          "source": "Q-04、Q-08"
        },
        {
          "name": "source_snapshot_at",
          "type": "TEXT",
          "nullable": false,
          "description": "备份快照时刻",
          "source": "Q-04、Q-08"
        },
        {
          "name": "recovery_target_at",
          "type": "TEXT",
          "nullable": false,
          "description": "本次演练模拟/故障的恢复基准时刻",
          "source": "Q-04、Q-08"
        },
        {
          "name": "application_version",
          "type": "TEXT",
          "nullable": false,
          "description": "用于读取恢复数据的应用版本",
          "source": "Q-04、Q-08"
        },
        {
          "name": "result_note",
          "type": "TEXT",
          "nullable": true,
          "description": "缺失项、失败原因及结论",
          "source": "Q-04、Q-08"
        }
      ],
      "constraints": [
        "copy_id所属backup_id一致且副本可用；隔离恢复不覆盖运行库。",
        "全部必需检查通过才记通过；实际耗时和恢复点间隔从时刻计算，分别对照4小时与24小时目标，超标记失败或未达标结论。",
        "生产切换另走受控停写、切换前备份、校验与回退；通过演练不自动切换。"
      ],
      "operations": [
        "执行隔离恢复",
        "汇总验证结果"
      ]
    },
    {
      "key": "restore_check",
      "table": "restore_check",
      "name": "恢复检查明细",
      "source": "Q-04、Q-08；T12",
      "reason": "保存每项恢复检查的结果及问题，避免只保留一个通过标志。",
      "fields": [
        {
          "name": "id",
          "type": "INTEGER",
          "nullable": false,
          "description": "稳定内部主键；PK。",
          "primary_key": true,
          "source": "Q-04、Q-08；T12"
        },
        {
          "name": "restore_id",
          "type": "INTEGER",
          "nullable": false,
          "description": "所属恢复验证；引用restore_verification.id。",
          "source": "Q-04、Q-08；T12",
          "foreign_key": "restore_verification"
        },
        {
          "name": "check_code",
          "type": "TEXT",
          "nullable": false,
          "description": "固定检查项目代码",
          "source": "Q-04、Q-08；T12"
        },
        {
          "name": "status",
          "type": "TEXT",
          "nullable": false,
          "description": "待检、通过或失败",
          "source": "Q-04、Q-08；T12"
        },
        {
          "name": "checked_at",
          "type": "TEXT",
          "nullable": true,
          "description": "完成检查时刻",
          "source": "Q-04、Q-08；T12"
        },
        {
          "name": "expected_value",
          "type": "TEXT",
          "nullable": false,
          "description": "预期集合、计数或结果描述",
          "source": "Q-04、Q-08；T12"
        },
        {
          "name": "actual_value",
          "type": "TEXT",
          "nullable": true,
          "description": "实际核实值；未检为空",
          "source": "Q-04、Q-08；T12"
        },
        {
          "name": "evidence_key",
          "type": "TEXT",
          "nullable": true,
          "description": "受控报告或截图位置",
          "source": "Q-04、Q-08；T12"
        },
        {
          "name": "failure_note",
          "type": "TEXT",
          "nullable": true,
          "description": "失败或缺失说明",
          "source": "Q-04、Q-08；T12"
        }
      ],
      "constraints": [
        "UNIQUE(restore_id,check_code)；数据库完整性、外键、清单附件、签署版本、退款余额、停用权限、应用读取及恢复时长/恢复点均为必检。",
        "检查证据不复制完整临床正文或明文凭据。关键检查缺行或未检不能汇总为通过。"
      ],
      "operations": [
        "保存逐项检查"
      ]
    }
