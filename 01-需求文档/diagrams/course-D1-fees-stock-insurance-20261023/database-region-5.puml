@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SimSun
skinparam defaultFontSize 19
skinparam ArrowColor black
skinparam EntityBackgroundColor white
skinparam EntityBorderColor black
skinparam nodesep 34
skinparam ranksep 45
hide circle
left to right direction
entity "费用申请\nfee_request" as fee_request {
* id : INTEGER <<PK>>
* patient_funds_id : INTEGER <<FK>>
 bill_id : INTEGER <<FK>>
 patient_payment_id : INTEGER <<FK>>
}
entity "费用调整\nfee_adjustment" as fee_adjustment {
* id : INTEGER <<PK>>
* fee_request_id : INTEGER <<FK,UK>>
* bill_id : INTEGER <<FK>>
}
entity "调整项目\nfee_adjustment_item" as fee_adjustment_item {
* id : INTEGER <<PK>>
* fee_adjustment_id : INTEGER <<FK>>
* bill_item_id : INTEGER <<FK>>
}
entity "退款办理\npatient_refund" as patient_refund {
* id : INTEGER <<PK>>
* fee_request_id : INTEGER <<FK>>
* patient_payment_id : INTEGER <<FK>>
* patient_funds_id : INTEGER <<FK>>
 previous_attempt_id : INTEGER <<FK>>
}
entity "应收账目（跨区引用）\nbill" as bill {
* id : INTEGER <<PK>>
}
entity "应收项目（跨区引用）\nbill_item" as bill_item {
* id : INTEGER <<PK>>
}
entity "患者资金（跨区引用）\npatient_funds" as patient_funds {
* id : INTEGER <<PK>>
}
entity "患者付款（跨区引用）\npatient_payment" as patient_payment {
* id : INTEGER <<PK>>
}
patient_funds ||--o{ fee_request
bill |o--o{ fee_request
patient_payment |o--o{ fee_request
fee_request ||--o| fee_adjustment
bill ||--o{ fee_adjustment
fee_adjustment ||--o{ fee_adjustment_item
bill_item ||--o{ fee_adjustment_item
fee_request ||--o{ patient_refund
patient_payment ||--o{ patient_refund
patient_funds ||--o{ patient_refund
patient_refund |o--o{ patient_refund
@enduml
