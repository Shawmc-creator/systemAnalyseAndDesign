@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SimSun
skinparam defaultFontSize 19
skinparam ArrowColor black
skinparam EntityBackgroundColor white
skinparam EntityBorderColor black
skinparam nodesep 34
skinparam ranksep 45
hide circle
left to right direction
entity "材料\nmaterial" as material {
* id : INTEGER <<PK>>
}
entity "材料批次\nmaterial_batch" as material_batch {
* id : INTEGER <<PK>>
* material_id : INTEGER <<FK>>
}
entity "批次变更\nbatch_change" as batch_change {
* id : INTEGER <<PK>>
* material_batch_id : INTEGER <<FK>>
}
entity "存放位置\nstock_location" as stock_location {
* id : INTEGER <<PK>>
}
entity "批次存量\nbatch_stock" as batch_stock {
* id : INTEGER <<PK>>
* material_batch_id : INTEGER <<FK>>
* stock_location_id : INTEGER <<FK>>
}
entity "库存变动\ninventory_movement" as inventory_movement {
* id : INTEGER <<PK>>
* batch_stock_id : INTEGER <<FK>>
 original_movement_id : INTEGER <<FK>>
 stock_count_id : INTEGER <<FK,UK>>
 purchase_receipt_item_id : INTEGER <<FK>>
}
entity "实际用料\nmaterial_usage" as material_usage {
* id : INTEGER <<PK>>
* inventory_movement_id : INTEGER <<FK>>
* visit_id : INTEGER <<FK>>
}
entity "盘点核实\nstock_count" as stock_count {
* id : INTEGER <<PK>>
* batch_stock_id : INTEGER <<FK>>
}
entity "验收项目（跨区引用）\npurchase_receipt_item" as purchase_receipt_item {
* id : INTEGER <<PK>>
}
entity "就诊（跨区引用）\nvisit" as visit {
* id : INTEGER <<PK>>
}
material ||--o{ material_batch
material_batch ||--o{ batch_change
material_batch ||--o{ batch_stock
stock_location ||--o{ batch_stock
batch_stock ||--o{ inventory_movement
inventory_movement |o--o{ inventory_movement
stock_count |o--o| inventory_movement
purchase_receipt_item |o--o{ inventory_movement
inventory_movement ||--o{ material_usage
visit ||--o{ material_usage
batch_stock ||--o{ stock_count
@enduml
