@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SimSun
skinparam defaultFontSize 17
skinparam dpi 200
skinparam ArrowColor black
skinparam NoteBackgroundColor white
skinparam NoteBorderColor black
skinparam ActorBackgroundColor white
skinparam BoundaryBackgroundColor white
skinparam ControlBackgroundColor white
hide footbox
skinparam maxMessageSize 200
skinparam sequenceMessageAlign center
skinparam sequence {
 ParticipantBackgroundColor white
 ParticipantBorderColor black
 LifeLineBorderColor black
 LifeLineBackgroundColor white
 ArrowColor black
 GroupBackgroundColor white
 GroupBorderColor black
}
actor "收费人员" as A0
boundary "<u>:收费人员接口</u>" as B0
control "<u>:查询账单与待结</u>\n<u>算费用控制</u>" as K
participant "<u>:应收账目</u>" as Bill
participant "<u>:应收项目</u>" as Charge
participant "<u>:患者资金</u>" as Funds
participant "<u>:患者付款</u>" as Payment
A0 -> B0 : 查询UC-06办理依据
activate B0
B0 -> B0 : 检查输入格式()
B0 -> K : 协调UC-06办理(对象、依据)
activate K
K -> Bill : 提供应收依据(患者、账目范围)
activate Bill
Bill -> Charge : 核对计价完整性(执行及价目依据)
activate Charge
Charge --> Bill : 处理结果或拒绝原因
deactivate Charge
Bill --> K : 处理结果或拒绝原因
deactivate Bill
K -> Funds : 核算付款及可用额(患者、账目范围)
activate Funds
Funds -> Payment : 核算来源余额(有效分配、抵扣及退款占用)
activate Payment
Payment --> Funds : 处理结果或拒绝原因
deactivate Payment
Funds --> K : 处理结果或拒绝原因
deactivate Funds
K --> B0 : 本阶段结果及下一步依据
deactivate K
B0 --> A0 : 展示结果、状态和原因
deactivate B0
note over K,Payment
校验不通过时返回规约中的原因；
本阶段不留下部分有效结果。
end note

@enduml
