@startuml
hide footbox
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SimSun
skinparam defaultFontSize 17
skinparam dpi 200
skinparam maxMessageSize 150
skinparam sequence {
 ArrowColor black
 ArrowFontSize 17
 LifeLineBorderColor black
 LifeLineBackgroundColor white
 ParticipantBorderColor black
 ParticipantBackgroundColor white
 GroupBorderColor black
 GroupBackgroundColor white
 GroupHeaderFontSize 16
 ParticipantFontSize 16
 ReferenceBackgroundColor white
 ReferenceBorderColor black
}
skinparam NoteBackgroundColor white
skinparam NoteBorderColor black
actor "收费人员" as A #white
boundary "<u>:收费人员接口</u>" as B #white
control "<u>:维护收费</u>\n<u>价目控制</u>" as K #white
participant "<u>:收费项目</u>" as S
participant "<u>:价目</u>" as P
A -> B : 新增或调整价目(项目)
activate B
B -> K : 取得项目价目(项目)
activate K
K -> S : 提供现有价目()
activate S
S -> P : 提供适用区间()
activate P
P --> S : 历史与当前价目
deactivate P
S --> K : 项目、单位及现有价目
deactivate S
K --> B : 当前价目及修改依据
deactivate K
B --> A : 展示现有价目（步骤1-2）
deactivate B
A -> B : 提交新价目(价目内容、确认信息)
activate B
B -> B : 检查输入及确认信息()
B -> K : 检查价目方案(价目内容)
activate K
K -> S : 检查价目方案(单位、单价、区间)
activate S
S -> P : 检查区间重叠(新区间)
activate P
P --> S : 无重叠或冲突区间
deactivate P
S --> K : 方案校验结果
deactivate S
K --> B : 待保存方案或错误
deactivate K
B --> A : 核对价目或提示问题（步骤3-4）
deactivate B
newpage
opt 方案合法，收费人员确认
A -> B : 确认价目(原修改依据)
activate B
B -> K : 维护收费价目(价目内容、原依据)
activate K
critical 版本与区间复查和保存同时完成
K -> S : 维护价目(价目内容、人员、原依据)
activate S
S -> S : 核对最新价目及无重叠()
opt 校验通过（6a时拒绝覆盖）
S -> P : 新增版本(单价、区间、确认信息)
activate P
P --> S : 新价目版本
deactivate P
end
S --> K : 保存结果或拒绝原因
deactivate S
end
K --> B : 本次保存结果
deactivate K
B --> A : 价目编号及适用时间，或原因（步骤5-6）
deactivate B
end
@enduml
