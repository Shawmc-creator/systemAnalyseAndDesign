@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 15
skinparam dpi 180
skinparam linetype ortho
skinparam nodesep 45
skinparam ranksep 55
skinparam ArrowColor #526575
skinparam classAttributeIconSize 0
skinparam class {
 BackgroundColor #FFFFFF
 BorderColor #34495E
 BorderThickness 1.3
 HeaderBackgroundColor #EAF1F7
 FontColor #172B3A
}
hide circle
hide methods
top to bottom direction
entity "现金收款\ncash_receipt" as cash_receipt {
 id [PK]
 --
 visit_id [FK, UQ]
 confirmation_id [FK, UQ]
 cashier_id [FK: staff]
 应收金额
 实际收到金额
 收款时间
}
entity "收款核对\ncash_reconciliation" as cash_reconciliation {
 id [PK]
 --
 cashier_id [FK: staff]
 营业日期
 系统净收快照
 盘点净收
 核对时间
}
entity "收款核对—现金收款关联\nreconciliation_receipt" as reconciliation_receipt {
 reconciliation_id [PK, FK]
 receipt_id [PK, FK]
}
entity "职员\nstaff" as staff {
 id [PK]
 --
 姓名
}
staff ||--o{ cash_reconciliation
cash_reconciliation ||--o{ reconciliation_receipt
cash_receipt ||--o{ reconciliation_receipt
staff ||--o{ cash_receipt
@enduml
