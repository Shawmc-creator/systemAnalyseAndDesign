@startuml
hide footbox
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SimSun
skinparam defaultFontSize 17
skinparam dpi 200
skinparam maxMessageSize 125
skinparam sequence {
 ArrowColor black
 ArrowFontSize 17
 LifeLineBorderColor black
 LifeLineBackgroundColor white
 ParticipantBorderColor black
 ParticipantBackgroundColor white
 GroupBorderColor black
 GroupBackgroundColor white
 GroupHeaderFontSize 16
 ParticipantFontSize 16
 ReferenceBackgroundColor white
 ReferenceBorderColor black
}
skinparam NoteBackgroundColor white
skinparam NoteBorderColor black
actor "牙医" as A #white
boundary "<u>:牙医接口</u>" as B #white
control "<u>:确认诊疗</u>\n<u>项目控制</u>" as K #white
participant "<u>:就诊</u>" as V
participant "<u>原确认:诊疗确认</u>" as O
participant "<u>新确认:诊疗确认</u>" as N
A -> B : 提交更正(原版本、原明细关联、原因及完整集合)
activate B
B -> B : 检查字段及更正原因()
B -> K : 更正诊疗确认()
activate K
critical 更正与收款复核同一当前版本
 K -> V : 更正确认(完整集合、原版本、牙医)
 activate V
 V -> V : 核对本人、未结清及最新版本()
 alt 基础条件有效
  V -> N : 校验拟生效完整明细集合()
  activate N
  ref over N
   同基本图：检查实际完成时间、方案归属、
   患者决定及拟生效数量，排除被替换版本。
  end ref
  alt 明细及方案校验全部通过
   V -> O : 提供原明细及计价依据()
   activate O
   O --> V : 原明细对象、原时点及价目
   deactivate O
   V -> N : 确定计价依据(原明细、本次时点)
   ref over N
    同辅助计价图：同项目继承原计价依据；
    新增或换项目按本次时点匹配。
   end ref
   N --> V : 待生效完整明细及价目依据
   V -> O : 保留原确认及历史明细()
   V -> N : 保存更正原因及新确认()
   V -> V : 替换当前版本，重算方案有效数量()
  else 明细或方案无效
   V -> V : 拒绝更正，原确认仍有效()
  end
  deactivate N
 else 已结清或原版本已变化
  V -> V : 拒绝过期更正()
 end
 V --> K : 新版本或拒绝原因
 deactivate V
end
K --> B : 本次更正结果
deactivate K
B --> A : 成功后重新核对费用，失败保留原内容
deactivate B
@enduml
