@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SimSun
skinparam defaultFontSize 18
skinparam dpi 220
skinparam ArrowColor black
left to right direction
skinparam nodesep 30
skinparam ranksep 55
skinparam actor {
 BorderColor black
 BackgroundColor white
}
skinparam usecase {
 BorderColor black
 BackgroundColor white
}
skinparam rectangle {
 BorderColor black
 BackgroundColor white
 FontStyle bold
}
actor/ "患者" as P
actor/ "供应商" as V
rectangle "青禾牙科诊所" {
 usecase/ "BUC-01\n预约与到诊" as U01
 usecase/ "BUC-02\n接受口腔检查与诊断" as U02
 usecase/ "BUC-03\n接受口腔治疗" as U03
 usecase/ "BUC-04\n接受复诊与随访" as U04
 usecase/ "BUC-05\n办理诊疗缴费" as U05
 usecase/ "BUC-06\n办理费用更正与退费" as U06
 usecase/ "BUC-07\n办理供货验收与结算" as U07
}
P --> U01
P --> U02
P --> U03
P --> U04
P --> U05
P --> U06
V --> U07
U02 -[hidden]right-> U01
U03 -[hidden]right-> U02
U04 -[hidden]right-> U03
U05 -[hidden]right-> U04
U06 -[hidden]right-> U05
U07 -[hidden]right-> U06
@enduml
