@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 15
skinparam dpi 180
skinparam ArrowColor #34495E
skinparam classAttributeIconSize 0
skinparam class {
 BackgroundColor white
 BorderColor #34495E
 HeaderBackgroundColor #EAF1F7
}
hide circle
skinparam nodesep 35
skinparam ranksep 45
hide footbox
skinparam maxMessageSize 155
skinparam sequence {
 ParticipantBackgroundColor #EAF1F7
 ParticipantBorderColor #34495E
 LifeLineBorderColor #708090
 GroupBackgroundColor white
 GroupBorderColor #708090
 MessageAlign left
}
autonumber
boundary ":岗位接口" as B
control ":UC-18控制" as K
participant ":材料" as E
participant ":材料变动" as P
participant ":盘点调整" as X
participant ":领域映射器" as M
participant ":工作单元" as W
B -> K : 登记库存变动(上下文, 命令)
activate K
K -> K : 职员.核验资格()；校验输入
K -> W : 开启写事务()
activate W
K -> M : 载入当前依据及操作提交(同一连接)
M --> K : 实体及当前持久化状态
alt 已办理且与本次请求一致
K -> K : 校验本人请求摘要；历史记录另核验原业务依据
K -> W : 结束事务()
K --> B : 原结果标识及当前状态
else 首次办理或合法变更
K -> M : 插入pending操作提交(原请求键, 摘要)
group 业务条件不满足即进入统一失败出口
K -> E : 登记变动(类型, 数量, 原版本, 盘点依据)
E -> P : 建立流水(前数, 差量, 后数, 用途)
opt 盘点调整
P -> X : 建立盘点(共用主键, 实盘, 确认)
X --> P : 共用标识的盘点子记录
end
P --> E : 变动及可选盘点子记录
E --> K : 新余额与流水集合
end
K -> M : 保存变更集(原版本条件, 同一连接)
M --> K : 标识及影响行数
K -> K : 核验全部写入结果
K -> M : 保存committed提交结果及成功审计(同一连接)
M --> K : 支撑记录保存完成
K -> W : 提交写事务()
K --> B : 已提交结果及新版本
end
deactivate W
deactivate K
@enduml
