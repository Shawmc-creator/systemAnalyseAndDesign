@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SimSun
skinparam defaultFontSize 18
skinparam dpi 220
skinparam ArrowColor black
hide footbox
skinparam sequenceMessageAlign center
skinparam ActorBorderColor black
skinparam ActorBackgroundColor white
skinparam sequence {
 ParticipantBorderColor transparent
 ParticipantBackgroundColor white
 LifeLineBorderColor black
 LifeLineBackgroundColor white
 ArrowColor black
 ActivationBorderColor black
 ActivationBackgroundColor white
}
actor "患者" as P
participant "<img:business-worker.png>\n收费人员" as C
participant "<img:business-worker.png>\n牙医" as D
P -> C : 提出缴费或预付费用
activate C
alt 结算实际诊疗费用
 C -> D : 核实实际项目、数量及更正情况
 D --> C : 确认费用依据
 C -> C : 查价并计算应收、已付和预付余额
else 预付后续费用
 C -> C : 核对患者及预付款用途
end
C -> P : 说明金额、支付方式及余额
P --> C : 确认并付款
C -> C : 清点现金或核实非现金到账
C -> C : 登记支付渠道、金额和分配\n注明预付余额或未付金额
C --> P : 交付凭据、找零及余额说明
deactivate C
@enduml
