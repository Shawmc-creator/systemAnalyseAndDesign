@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SimSun
skinparam defaultFontSize 18
skinparam dpi 220
skinparam ArrowColor black
skinparam nodesep 24
skinparam ranksep 65
skinparam actor {
 BorderColor black
 BackgroundColor white
}
skinparam usecase {
 BorderColor black
 BackgroundColor white
}
skinparam rectangle {
 BorderColor black
 BackgroundColor white
}
skinparam defaultFontSize 17
skinparam ranksep 55
left to right direction
actor "前台" as A0
boundary "前台接口" as B0 #white
A0 -- B0
control "查询可用接诊安排控制\nUC-16" as K16 #white
B0 ..> K16
actor "牙医" as A1
boundary "牙医接口" as B1 #white
A1 -- B1
B1 ..> K16
actor "诊疗助理" as A2
boundary "诊疗助理接口" as B2 #white
A2 -- B2
control "查询材料库存控制\nUC-17" as K17 #white
B2 ..> K17
control "登记材料变动控制\nUC-18" as K18 #white
B2 ..> K18
actor "收费人员" as A3
boundary "收费人员接口" as B3 #white
A3 -- B3
control "查询日常业务与收款控制\nUC-19" as K19 #white
B3 ..> K19
control "登记收款核对控制\nUC-20" as K20 #white
B3 ..> K20
actor "诊所负责人" as A4
boundary "诊所负责人接口" as B4 #white
A4 -- B4
control "维护接诊人员安排控制\nUC-15" as K15 #white
B4 ..> K15
B4 ..> K17
B4 ..> K19

K15 -[hidden]right-> K16
K16 -[hidden]right-> K17
K17 -[hidden]right-> K18
K18 -[hidden]right-> K19
K19 -[hidden]right-> K20
A0 -[hidden]right-> A1
A1 -[hidden]right-> A2
A2 -[hidden]right-> A4
A4 -[hidden]right-> A3
@enduml
