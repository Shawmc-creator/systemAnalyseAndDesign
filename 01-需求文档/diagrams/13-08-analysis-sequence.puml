@startuml
hide footbox
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SimSun
skinparam defaultFontSize 16
skinparam dpi 200
skinparam maxMessageSize 150
skinparam sequence {
 ArrowColor black
 ArrowFontSize 16
 LifeLineBorderColor black
 LifeLineBackgroundColor white
 ParticipantBorderColor black
 ParticipantBackgroundColor white
 GroupBorderColor black
 GroupBackgroundColor white
 ParticipantFontSize 16
}
skinparam NoteBackgroundColor white
skinparam NoteBorderColor black
actor "前台" as A
boundary "<u>:前台接口</u>" as B #white
control "<u>:维护患者资料控制</u>" as K #white
participant "<u>:患者</u>" as E
participant "<u>:患者资料变更</u>" as E2
A -> B : 请求维护患者资料（步骤1）
activate B
B -> K : 取得办理依据()
activate K
K -> E : 提供已有及相似患者()
activate E
E --> K : 身份资料及相似候选
deactivate E
K --> B : 当前办理依据
deactivate K
B --> A : 反馈内容（步骤2）
deactivate B
A -> B : 提交姓名、电话及修改原因（步骤3）
activate B
B -> K : 校验办理内容()
activate K
K -> E : 核对身份及维护资料()
activate E
E --> K : 业务条件判断
deactivate E
K -> E2 : 校验变更原因及原资料()
activate E2
E2 --> K : 关联依据及校验结果
deactivate E2
alt 资料完整且身份已核对
 K --> B : 可确认内容
 deactivate K
 B --> A : 反馈核对内容（步骤4）
 deactivate B
newpage
 A -> B : 确认提交（步骤5）
 activate B
 B -> K : 确认办理()
 activate K
 critical 最后核验与保存同时完成
  K -> E : 再次核对当前有效依据()
  activate E
  E --> K : 有效或已变化
  deactivate E
  alt 当前依据有效
   K -> E : 保存资料及维护经历()
   activate E
   opt 修改已有患者资料
   E -> E2 : 保留原值及原因()
   activate E2
   E2 --> E : 已关联业务经历
   deactivate E2
   end
   E --> K : 已保存业务结果
   deactivate E
  else 当前依据已变化
   note over K,E : 拒绝过期提交，保留原有效内容。
  end
 end
 K --> B : 保存结果或具体原因
 deactivate K
 B --> A : 反馈结果（步骤6）
 deactivate B
else 校验不通过
 K --> B : 拒绝原因
 deactivate K
 B --> A : 具体问题，修正后再提交
 deactivate B
end
note over K,E2 : 存在相似患者或原资料已变化：\n按原患者核对；不同患者须明确确认，拒绝覆盖旧内容。
note over E,E2 : 变更经历与资料维护共同保存；新增时不伪造原值。

@enduml
