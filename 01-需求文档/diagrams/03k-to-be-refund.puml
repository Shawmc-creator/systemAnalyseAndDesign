@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SimSun
skinparam defaultFontSize 18
skinparam dpi 220
skinparam ArrowColor black
hide footbox
skinparam sequenceMessageAlign center
skinparam ActorBorderColor black
skinparam ActorBackgroundColor white
skinparam sequence {
 ParticipantBorderColor transparent
 ParticipantBackgroundColor white
 LifeLineBorderColor black
 LifeLineBackgroundColor white
 ArrowColor black
 ActivationBorderColor black
 ActivationBackgroundColor white
}
actor "患者" as P
participant "<img:business-worker.png>\n收费人员" as C
participant "<img:business-worker.png>\n牙医" as D
participant "<img:business-worker.png>\n诊所负责人" as M
participant "<img:business-entity.png>\n牙科诊所管理系统" as S
P -> C : 提出费用异议或退回未用预付款
activate C
C -> S : 查询原账单、支付分配和已有退款
S --> C : 返回可核对依据与剩余可退金额
opt 涉及诊疗项目
 C -> D : 核实实际治疗及费用依据
 D --> C : 提供核实结果及更正说明
end
C -> S : 登记申请、原因及拟处理金额
M -> S : 审阅依据并记录处理意见
S --> C : 返回确认结果
alt 同意退费
 C -> P : 核对退款金额及方式
 P --> C : 确认退款接收信息
 C -> C : 办理实际退款并核实结果
 alt 实际退款已确认
  C -> S : 登记已核实退款及交易凭据
  S -> S : 检查可退余额和重复请求\n保留原单、调整及退款关联
  S --> C : 返回退款记录和余额
  C --> P : 交付退款结果与凭据
 else 退款失败或结果不明
  C -> S : 登记待核实状态及原因
  S --> C : 返回待跟进事项
  C --> P : 告知核实进度
 end
else 不予办理或资料不足
 C --> P : 说明理由及需补充事项
end
deactivate C
@enduml
