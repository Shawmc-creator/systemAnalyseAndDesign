@startuml
' Business symbols extracted from course PPT PDF pages 86-87. System uses the business entity symbol.
hide footbox
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SimSun
skinparam defaultFontSize 17
skinparam dpi 220
skinparam sequenceMessageAlign center
skinparam ActorBorderColor black
skinparam ActorBackgroundColor white
skinparam sequence {
 ParticipantBorderColor transparent
 ParticipantBackgroundColor white
 LifeLineBorderColor black
 LifeLineBackgroundColor white
 ArrowColor black
 ActivationBorderColor black
 ActivationBackgroundColor white
}
actor "患者" as P
participant "<img:business-worker.png>\n前台" as F
participant "<img:business-entity.png>\n牙科诊所管理系统" as S
P -> F : 请求办理到诊接待
activate F
F -> P : 核实姓名及预约信息（a）
P --> F : 提供姓名、联系电话及预约时间
F -> S : 查询本次预约及接诊安排
activate S
S --> F : 返回预约记录及已确认的安排
deactivate S
F -> F : 核对患者与预约记录一致
F -> S : 登记本次到诊
activate S
S -> S : 关联预约信息\n记录到诊状态
S --> F : 返回登记结果及候诊安排
deactivate S
F -> P : 告知接诊牙医及候诊安排（b）
deactivate F
@enduml
