@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SimSun
skinparam defaultFontSize 18
skinparam dpi 220
skinparam ArrowColor black
hide footbox
skinparam sequenceMessageAlign center
skinparam ActorBorderColor black
skinparam ActorBackgroundColor white
skinparam sequence {
 ParticipantBorderColor transparent
 ParticipantBackgroundColor white
 LifeLineBorderColor black
 LifeLineBackgroundColor white
 ArrowColor black
 ActivationBorderColor black
 ActivationBackgroundColor white
}
actor "患者" as P
participant "<img:business-worker.png>\n前台" as F
participant "<img:business-worker.png>\n牙医" as D
participant "<img:business-entity.png>\n牙科诊所管理系统" as S
P -> F : 到诊并提供身份及联系方式
activate F
F -> S : 查找患者档案及预约
S --> F : 返回资料、历史编号及预约
opt 资料重复、变更或需代理办理
 F -> P : 核实身份、联系信息及办理依据
 P --> F : 补充或确认资料
 F -> S : 保存变更或经核实的合并依据
 S --> F : 返回保留历史的档案结果
end
alt 已有预约
 F -> S : 关联预约并登记到诊
else 现场到诊
 F -> D : 协调当日接诊安排
 D --> F : 确认可接诊条件
 F -> S : 登记现场接诊来源及到诊
end
S --> F : 返回独立就诊及候诊安排
F -> D : 告知待接诊患者
F --> P : 告知候诊安排
deactivate F
@enduml
