@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SimSun
skinparam defaultFontSize 17
skinparam dpi 200
skinparam ArrowColor black
skinparam NoteBackgroundColor white
skinparam NoteBorderColor black
skinparam ActorBackgroundColor white
skinparam BoundaryBackgroundColor white
skinparam ControlBackgroundColor white
hide footbox
skinparam maxMessageSize 200
skinparam sequenceMessageAlign center
skinparam sequence {
 ParticipantBackgroundColor white
 ParticipantBorderColor black
 LifeLineBorderColor black
 LifeLineBackgroundColor white
 ArrowColor black
 GroupBackgroundColor white
 GroupBorderColor black
}
actor "收费人员" as A0
boundary "<u>:收费人员接口</u>" as B0
control "<u>:查询经营与资金</u>\n<u>明细控制</u>" as K
participant "<u>:就诊</u>" as Visit
participant "<u>:应收账目</u>" as Bill
participant "<u>:患者资金</u>" as Funds
participant "<u>:供应商资金</u>" as SupplierFunds
A0 -> B0 : 查询UC-19办理依据
activate B0
B0 -> B0 : 检查输入格式()
B0 -> K : 协调UC-19办理(对象、依据)
activate K
K -> Visit : 汇总诊疗发生(期间和岗位范围)
activate Visit
Visit --> K : 处理结果或拒绝原因
deactivate Visit
K -> Bill : 汇总有效应收(同一统计时点)
activate Bill
Bill --> K : 处理结果或拒绝原因
deactivate Bill
K -> Funds : 汇总患者资金(渠道、期间、确认结果)
activate Funds
Funds --> K : 处理结果或拒绝原因
deactivate Funds
K -> SupplierFunds : 汇总供货收支(同一期间及渠道)
activate SupplierFunds
SupplierFunds --> K : 处理结果或拒绝原因
deactivate SupplierFunds
K --> B0 : 本阶段结果及下一步依据
deactivate K
B0 --> A0 : 展示结果、状态和原因
deactivate B0
note over K,SupplierFunds
校验不通过时返回规约中的原因；
本阶段不留下部分有效结果。
end note

@enduml
