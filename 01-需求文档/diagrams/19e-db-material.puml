@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 15
skinparam dpi 180
skinparam linetype ortho
skinparam nodesep 45
skinparam ranksep 55
skinparam ArrowColor #526575
skinparam classAttributeIconSize 0
skinparam class {
 BackgroundColor #FFFFFF
 BorderColor #34495E
 BorderThickness 1.3
 HeaderBackgroundColor #EAF1F7
 FontColor #172B3A
}
hide circle
hide methods
top to bottom direction
entity "材料\nmaterial" as material {
 id [PK]
 --
 名称
 计量单位
 账面数量
}
entity "材料变动\nmaterial_movement" as material_movement {
 id [PK]
 --
 material_id [FK]
 operator_id [FK: staff]
 类型
 变动数量
 前数量
 后数量
}
entity "盘点调整\nstocktake_adjustment" as stocktake_adjustment {
 movement_id [PK, FK]
 --
 confirmed_by [FK: staff]
 实盘数量
 负责人确认时间
 确认依据
}
entity "职员\nstaff" as staff {
 id [PK]
 --
 姓名
}
material ||--o{ material_movement
staff ||--o{ material_movement
material_movement ||--o| stocktake_adjustment
staff ||--o{ stocktake_adjustment
@enduml
