@startuml
hide footbox
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SimSun
skinparam defaultFontSize 16
skinparam dpi 200
skinparam maxMessageSize 150
skinparam sequence {
 ArrowColor black
 ArrowFontSize 16
 LifeLineBorderColor black
 LifeLineBackgroundColor white
 ParticipantBorderColor black
 ParticipantBackgroundColor white
 GroupBorderColor black
 GroupBackgroundColor white
 ParticipantFontSize 16
}
skinparam NoteBackgroundColor white
skinparam NoteBorderColor black
actor "收费人员" as A
boundary "<u>:收费人员接口</u>" as B #white
control "<u>:查询日常业务与收款控制</u>" as K #white
participant "<u>:就诊</u>" as E
participant "<u>:现金收款</u>" as E2
participant "<u>:诊疗明细</u>" as E3
A -> B : 提交查询条件（步骤1）
activate B
B -> B : 检查基本格式()
B -> K : 查询日常业务与收款(条件、操作者)
activate K
K -> E : 汇总指定期间到诊及未结清()
activate E
E --> K : 就诊与未结清明细
deactivate E
alt 日期及获准查询范围有效
 K -> E2 : 按实际收款日期汇总净收()
 activate E2
 E2 --> K : 有效收据及现金净收
 deactivate E2
 K -> E3 : 按实际完成日期汇总当前有效明细()
 activate E3
 E3 --> K : 已完成项目及数量
 deactivate E3
 K --> B : 查询结果与业务口径（步骤2-3）
 B --> A : 反馈可核对明细
else 条件无效或范围无权
 K --> B : 拒绝原因，不返回越权内容
 B --> A : 反馈问题
end
deactivate K
deactivate B
opt 选择获准明细（步骤4）
 A -> B : 提交选定业务对象
 activate B
 B -> K : 取得当前明细()
 activate K
 K -> E : 提供当前获准详情()
 activate E
 E --> K : 当前详情或不可访问原因
 deactivate E
 K --> B : 当前结果
 deactivate K
 B --> A : 反馈结果
 deactivate B
end
note over K,E2 : 无业务反馈空明细；统计失败不得作为零；查询不写入业务。

@enduml
