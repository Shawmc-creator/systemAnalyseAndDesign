@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SimSun
skinparam defaultFontSize 19
skinparam ArrowColor black
skinparam ComponentBackgroundColor white
skinparam PackageBackgroundColor white
skinparam nodesep 20
skinparam ranksep 22
top to bottom direction
package "表示层" {
 [岗位工作台] as UI
}
package "业务层" {
 [应用服务\n接诊临床／费用随访／物资资源] as A
 [领域实体与规则] as E
 [支付及医保适配] as X
 A -right-> E
 A -left-> X
}
package "数据访问层" {
 [存取接口与数据映射器] as M
 [文件存取接口] as FM
 M -[hidden]right-> FM
}
database "SQLite业务数据" as DB
folder "影像文书原件" as FS
cloud "支付／医保平台" as EXT
UI --> A
A --> M
A --> FM
M ..> E : 装配与保存
M --> DB : SQL／本地事务
FM --> FS
X --> EXT
@enduml
