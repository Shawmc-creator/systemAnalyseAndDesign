@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SimSun
skinparam defaultFontSize 19
skinparam ArrowColor black
skinparam ClassBackgroundColor white
skinparam ActorBackgroundColor white
skinparam sequenceMessageAlign center
skinparam classAttributeIconSize 0
left to right direction
class "基础管理接口" as B <<controller>> {
 接收对象、动作、版本及核实依据()
 按当前身份调用维护服务()
}
class "基础管理应用服务" as C <<application>> {
 UC-26 维护诊所基础资料与账号()
 协调在岗、授权及排班影响核对()
 共同保存结果与操作依据()
}
class "职员" as E1 <<entity>> {
 核对在岗期间()
 核实任职及授权依据()
}
class "职员账号" as E2 <<entity>> {
 核验办理授权()
 授予或撤销已核实岗位()
 停用或恢复账号()
}
class "诊椅" as E3 <<entity>> {
 核对资源有效期间()
 核对退役条件()
 确认诊椅退役()
}
interface "基础资料存取接口" as R {
 读取职员、账号、任职及资源(稳定键)
 查询有效管理入口和排班影响()
 保存本次基础资料及授权(版本)
}
class "SQLite基础资料映射器" as DB <<mapper>> {
 映射既有人员、账号及资源表()
 同事务保存任职授予及审计()
}
B --> C
C --> E1
C --> E2
C --> E3
C --> R
DB ..|> R
note bottom of R
职员、账号、诊椅复用原分析实体。
任职与授予以既有技术关联表实现，
不另建医生或住院床位重复主表。
end note
@enduml
