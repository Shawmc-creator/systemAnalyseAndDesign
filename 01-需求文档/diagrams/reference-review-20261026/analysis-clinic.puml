@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SimSun
skinparam defaultFontSize 19
skinparam ArrowColor black
skinparam ClassBackgroundColor white
skinparam ActorBackgroundColor white
skinparam sequenceMessageAlign center
skinparam classAttributeIconSize 0
left to right direction
allowmixing
actor "诊所负责人" as M
boundary "诊所基础管理边界" as B
control "维护基础资料与账号控制" as C
class "职员" as S <<entity>> {
 职员编号、姓名、在岗期间
 --
 核对在岗期间()
 建立职员资料()
 核实任职及授权依据()
}
class "职员账号" as A <<entity>> {
 个人登录名、启停状态、授权版本
 /获准岗位集合
 --
 核对账号可用性()
 核验办理授权()
 建立个人账号()
 授予或撤销已核实岗位()
 停用或恢复账号()
}
class "诊椅" as H <<entity>> {
 诊椅编号、名称、有效期间
 --
 核对资源有效期间()
 登记诊椅()
 核对退役条件()
 确认诊椅退役()
}
M -- B
B --> C
C ..> S
C ..> A
C ..> H
S "1" -- "0..1" A : 使用个人账号
note bottom of A
获准岗位为任职与授权的派生结果；
兼岗保留同一职员身份。
end note
@enduml
