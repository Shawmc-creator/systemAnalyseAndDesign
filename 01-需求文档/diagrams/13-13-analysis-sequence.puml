@startuml
hide footbox
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SimSun
skinparam defaultFontSize 16
skinparam dpi 200
skinparam maxMessageSize 150
skinparam sequence {
 ArrowColor black
 ArrowFontSize 16
 LifeLineBorderColor black
 LifeLineBackgroundColor white
 ParticipantBorderColor black
 ParticipantBackgroundColor white
 GroupBorderColor black
 GroupBackgroundColor white
 ParticipantFontSize 16
}
skinparam NoteBackgroundColor white
skinparam NoteBorderColor black
actor "前台" as A
boundary "<u>:前台接口</u>" as B #white
control "<u>:办理复诊随访联系控制</u>" as K #white
participant "<u>:诊后要求</u>" as E
participant "<u>:预约</u>" as E2
participant "<u>:联系经历</u>" as E3
A -> B : 查询待联系要求（步骤1）
activate B
B -> K : 取得办理依据()
activate K
K -> E : 提供来源及联系经历()
activate E
E --> K : 要求、患者及已有办理结果
deactivate E
K --> B : 当前办理依据
deactivate K
B --> A : 反馈内容（步骤2）
deactivate B
A -> B : 提交实际联系、反馈及下一步安排（步骤3）
activate B
B -> K : 校验办理内容()
activate K
K -> E : 判断可联系()
activate E
E --> K : 业务条件判断
deactivate E
opt 请求关联复诊预约
K -> E2 : 核对同患者及有效预约()
activate E2
E2 --> K : 关联依据及校验结果
deactivate E2
end
alt 要求可办理，反馈及后续安排有效
 K --> B : 可确认内容
 deactivate K
 B --> A : 反馈核对内容（步骤4）
 deactivate B
newpage
 A -> B : 确认提交（步骤5）
 activate B
 B -> K : 确认办理()
 activate K
 critical 最后核验与保存同时完成
  K -> E : 再次核对当前有效依据()
  activate E
  E --> K : 有效或已变化
  deactivate E
  alt 当前依据有效
   K -> E : 追加联系并更新办理结果()
   activate E
   E -> E3 : 追加实际联系()
   activate E3
   E3 --> E : 已关联业务经历
   deactivate E3
   E --> K : 已保存业务结果
   deactivate E
  else 当前依据已变化
   note over K,E : 拒绝过期提交，保留原有效内容。
  end
 end
 K --> B : 保存结果或具体原因
 deactivate K
 B --> A : 反馈结果（步骤6）
 deactivate B
else 校验不通过
 K --> B : 拒绝原因
 deactivate K
 B --> A : 具体问题，修正后再提交
 deactivate B
end
note over K,E2 : 未接通、已约复诊或取消：\n未接通留下一日期；已约关联有效预约；取消留原因。

@enduml
