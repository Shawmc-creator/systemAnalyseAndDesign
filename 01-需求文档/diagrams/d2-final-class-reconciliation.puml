@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SimSun
skinparam defaultFontSize 17
skinparam ArrowColor black
skinparam classBackgroundColor white
skinparam classBorderColor black
skinparam classAttributeIconSize 0
skinparam linetype polyline
hide empty members

left to right direction
skinparam nodesep 65
skinparam ranksep 95
class "患者付款" as Payment <<entity>> {
 -id: ObjectId
 -net_cents: Int64
 -received_cents: Int64
 -change_cents: Int64
 -channel: Text
 +核算来源余额(依据: 操作输入): 业务结果
 +确认到账(依据: 操作输入): 业务结果
 +分配已收款(依据: 操作输入): 业务结果
 +调整已分配范围(依据: 操作输入): 业务结果
 +核对来源可退额(依据: 操作输入): 业务结果
 +核对未分配余额(依据: 操作输入): 业务结果
 +确认预付用途(依据: 操作输入): 业务结果
 +提出到账核查(依据: 操作输入): 业务结果
 +确认未到账(依据: 操作输入): 业务结果
}
class "退款办理" as Refund <<entity>> {
 -id: ObjectId
 -requested_cents: Int64
 -actual_cents: Int64?
 -initiated_at: Text
 -channel: Text
 +建立额度占用(依据: 操作输入): 业务结果
 +核实办理结果(依据: 操作输入): 业务结果
 +提供办理进度(依据: 操作输入): 业务结果
 +保留额度占用(依据: 操作输入): 业务结果
}
class "供货付款" as SupplyPayment <<entity>> {
 -id: ObjectId
 -requested_cents: Int64
 -actual_cents: Int64?
 -channel: Text
 -initiated_at: Text
 +建立付款占用(依据: 操作输入): 业务结果
 +确认实际支出(依据: 操作输入): 业务结果
 +核实待定结果(依据: 操作输入): 业务结果
}
class "供货退款" as SupplyRefund <<entity>> {
 -id: ObjectId
 -received_cents: Int64
 -channel: Text
 -received_at: Text
 -transaction_evidence: Text
 +保留原款退款(依据: 操作输入): 业务结果
}
class "收支核对" as Reconciliation <<entity>> {
 -id: ObjectId
 -business_date: Text
 -channel: Text
 -cutoff_at: Text
 -actual_cents: Int64
 +形成核对快照(依据: 操作输入): 业务结果
 +计算核对差额(依据: 操作输入): 业务结果
}
class "核对项目" as ReconciliationItem <<entity>> {
 -id: ObjectId
 -source_type: Text
 -included_cents: Int64
 -source_at: Text
 -source_revision: Int64
 +保留核对项目(依据: 操作输入): 业务结果
}
class "差异跟进" as FollowIssue <<entity>> {
 -id: ObjectId
 -reason: Text
 -due_date: Text
 -action_note: Text
 -completed_at: Text?
 +登记差异责任(依据: 操作输入): 业务结果
 +登记异常追查(依据: 操作输入): 业务结果
 +追加处理结论(依据: 操作输入): 业务结果
}
class "职员" as Staff <<entity>> {
 -id: ObjectId
 -name: Text
 -employed_from: Text
 -employed_until: Text?
 -record_no: Text
 +核对在岗与职责(依据: 操作输入): 业务结果
}
Payment "1" -- "0..*" Refund : 原款来源
SupplyPayment "1" -- "0..*" SupplyRefund : 原付款
Reconciliation "1" *-- "0..*" ReconciliationItem : 核对快照
Payment "0..1" -- "0..*" ReconciliationItem : 患者到账
Refund "0..1" -- "0..*" ReconciliationItem : 患者退款
SupplyPayment "0..1" -- "0..*" ReconciliationItem : 供货付款
SupplyRefund "0..1" -- "0..*" ReconciliationItem : 供货退回
Reconciliation "0..1" -- "0..*" FollowIssue : 收支差异
Staff "1" -- "0..*" FollowIssue : 跟进责任人
@enduml