@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SimSun
skinparam defaultFontSize 17
skinparam ArrowColor black
skinparam ClassBackgroundColor white
skinparam ActorBackgroundColor white
skinparam BoundaryBackgroundColor white
skinparam ControlBackgroundColor white
skinparam EntityBackgroundColor white
skinparam NoteBackgroundColor white
skinparam NoteBorderColor black
skinparam classAttributeIconSize 0
skinparam nodesep 24
skinparam ranksep 34
hide footbox
autonumber
skinparam maxMessageSize 120
actor "牙医" as A
boundary "牙医接口" as B
control "登记实际治疗与\n完成项目控制" as K
entity "就诊" as E0
entity "诊疗执行" as E1
entity "价目" as E2
entity "应收项目" as E3
A -> B : 登记实际治疗与完成项目
B -> K : 提交对象编号及办理内容
activate K
K -> K : 核对岗位权限与必要资料
alt 可以办理
K -> E0 : 核对当次患者就诊与执行范围
activate E0
E0 --> K : 当次诊疗依据
deactivate E0
K -> E1 : 记录实际检查治疗及完成数量
activate E1
E1 --> K : 实际执行来源
deactivate E1
K -> E2 : 核对适用的已确认价目
activate E2
E2 --> K : 本次计价依据
deactivate E2
K -> E3 : 形成实际项目费用明细
activate E3
E3 --> K : 待核对费用
deactivate E3
K --> B : 返回本次结果
else 权限资料或状态不符合
K --> B : 返回核对原因且不改变原记录
end
B --> A : 展示结果
deactivate K

@enduml
