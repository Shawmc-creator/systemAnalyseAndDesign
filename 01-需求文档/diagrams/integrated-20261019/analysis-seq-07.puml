@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SimSun
skinparam defaultFontSize 17
skinparam ArrowColor black
skinparam ClassBackgroundColor white
skinparam ActorBackgroundColor white
skinparam BoundaryBackgroundColor white
skinparam ControlBackgroundColor white
skinparam EntityBackgroundColor white
skinparam NoteBackgroundColor white
skinparam NoteBorderColor black
skinparam classAttributeIconSize 0
skinparam nodesep 24
skinparam ranksep 34
hide footbox
autonumber
skinparam maxMessageSize 120
actor "牙医" as A
boundary "牙医接口" as B
control "制定治疗方案并\n记录患者确认控制" as K
entity "治疗方案" as E0
entity "方案版本" as E1
entity "方案项目" as E2
entity "患者决定" as E3
A -> B : 制定治疗方案并记录患者确\n认
B -> K : 提交对象编号及办理内容
activate K
K -> K : 核对岗位权限与必要资料
alt 可以办理
K -> E0 : 建立或查找患者方案
activate E0
E0 --> K : 方案编号
deactivate E0
K -> E1 : 保存本次说明的方案版本
activate E1
E1 --> K : 版本及预计安排
deactivate E1
K -> E2 : 保存项目牙位和估算
activate E2
E2 --> K : 方案明细
deactivate E2
K -> E3 : 记录患者确认及其项目范围
activate E3
E3 --> K : 同意暂缓或拒绝的决定
deactivate E3
K --> B : 返回本次结果
else 权限资料或状态不符合
K --> B : 返回核对原因且不改变原记录
end
B --> A : 展示结果
deactivate K

@enduml
