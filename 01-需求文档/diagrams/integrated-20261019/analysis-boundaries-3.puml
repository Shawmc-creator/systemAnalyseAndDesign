@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SimSun
skinparam defaultFontSize 17
skinparam ArrowColor black
skinparam ClassBackgroundColor white
skinparam ActorBackgroundColor white
skinparam BoundaryBackgroundColor white
skinparam ControlBackgroundColor white
skinparam EntityBackgroundColor white
skinparam NoteBackgroundColor white
skinparam NoteBorderColor black
skinparam classAttributeIconSize 0
skinparam nodesep 24
skinparam ranksep 34
left to right direction
actor "收费人员" as A0
boundary "收费人员接口" as B0
A0 -- B0
control "UC-11\n维护收费项目与价\n目控制" as C0_11
B0 ..> C0_11
control "UC-12\n查询账单与待结算\n费用控制" as C0_12
B0 ..> C0_12
control "UC-13\n办理患者付款与到\n账核实控制" as C0_13
B0 ..> C0_13
control "UC-14\n办理费用更正与退\n费控制" as C0_14
B0 ..> C0_14
control "UC-21\n核对日常经营与收\n付款控制" as C0_21
B0 ..> C0_21
control "UC-22\n核验医保身份并办\n理预结算控制" as C0_22
B0 ..> C0_22
control "UC-23\n办理医保结算、撤\n销与回款核对控制" as C0_23
B0 ..> C0_23

@enduml
