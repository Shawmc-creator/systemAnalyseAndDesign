control "UC-10\n管理影像与诊疗文\n书控制" as C0_10
B0 ..> C0_10
control "UC-18\n维护材料与批次资\n料控制" as C0_18
B0 ..> C0_18
control "UC-19\n登记基础采购与到\n货验收控制" as C0_19
B0 ..> C0_19
control "UC-20\n办理库存领用、退\n回与盘点控制" as C0_20
B0 ..> C0_20
control "UC-24\n协调诊椅设备准备\n与停用恢复控制" as C0_24
B0 ..> C0_24
actor "诊所负责人" as A1
boundary "诊所负责人接口" as B1
A1 -- B1
control "UC-04\n维护排班与接诊安\n排控制" as C1_4
B1 ..> C1_4
control "UC-11\n维护收费项目与价\n目控制" as C1_11
B1 ..> C1_11
control "UC-14\n办理费用更正与退\n费控制" as C1_14
B1 ..> C1_14
control "UC-18\n维护材料与批次资\n料控制" as C1_18
B1 ..> C1_18
control "UC-19\n登记基础采购与到\n货验收控制" as C1_19
B1 ..> C1_19
control "UC-20\n办理库存领用、退\n回与盘点控制" as C1_20
B1 ..> C1_20
control "UC-21\n核对日常经营与收\n付款控制" as C1_21
B1 ..> C1_21
control "UC-23\n办理医保结算、撤\n销与回款核对控制" as C1_23
B1 ..> C1_23
control "UC-24\n协调诊椅设备准备\n与停用恢复控制" as C1_24
B1 ..> C1_24

@enduml
