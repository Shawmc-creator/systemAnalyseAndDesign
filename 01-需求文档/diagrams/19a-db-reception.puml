@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 15
skinparam dpi 180
skinparam linetype ortho
skinparam nodesep 45
skinparam ranksep 55
skinparam ArrowColor #526575
skinparam classAttributeIconSize 0
skinparam class {
 BackgroundColor #FFFFFF
 BorderColor #34495E
 BorderThickness 1.3
 HeaderBackgroundColor #EAF1F7
 FontColor #172B3A
}
hide circle
hide methods
top to bottom direction
entity "患者\npatient" as patient {
 id [PK]
 --
 姓名
 联系电话
 出生日期
}
entity "职员\nstaff" as staff {
 id [PK]
 --
 姓名
}
entity "预约\nappointment" as appointment {
 id [PK]
 --
 patient_id [FK]
 dentist_id [FK: staff]
 created_by [FK: staff]
 arrangement_version
 起始时间
 结束时间
}
entity "预约变更\nappointment_change" as appointment_change {
 id [PK]
 --
 appointment_id [FK]
 operator_id [FK: staff]
 previous_dentist_id [FK: staff]
 old_arrangement_version
 发生时间
 变更类型
}
entity "就诊\nvisit" as visit {
 id [PK]
 --
 appointment_id [FK, UQ]
 patient_id [FK]
 registered_by [FK: staff]
 current_confirmation_id [FK, UQ, 可空]
 到诊时间
}
entity "接诊时段\nreception_slot" as reception_slot {
 id [PK]
 --
 dentist_id [FK: staff]
 confirmed_by [FK: staff]
 published_by [FK: staff]
 适用星期
 起始时间
 结束时间
}
entity "接诊时段变更\nslot_change" as slot_change {
 id [PK]
 --
 slot_id [FK]
 operator_id [FK: staff]
 发生时间
 原起止时间
 变更原因
}
entity "接诊时段—预约关联\nappointment_slot" as appointment_slot {
 appointment_id [PK, FK]
 arrangement_version [PK]
 slot_id [PK, FK]
 --
 slot_revision
 confirmed_by [FK: staff]
 confirmed_at
 confirmation_basis
}
patient ||--o{ appointment
patient ||--o{ visit
staff ||--o{ appointment
staff ||--o{ reception_slot
appointment ||--o{ appointment_change
appointment ||--o| visit
reception_slot ||--o{ slot_change
appointment ||--|{ appointment_slot
reception_slot ||--o{ appointment_slot
appointment_change -[hidden]down-> visit
slot_change -[hidden]down-> appointment_slot
@enduml
