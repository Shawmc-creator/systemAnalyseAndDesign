@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SimSun
skinparam defaultFontSize 20
skinparam ArrowColor black
skinparam ClassBackgroundColor white
skinparam NoteBackgroundColor white
skinparam NoteBorderColor black
skinparam PackageBackgroundColor white
skinparam PackageBorderColor black
skinparam classAttributeIconSize 0
skinparam minClassWidth 220
skinparam linetype ortho
skinparam nodesep 70
skinparam ranksep 80
hide circle
hide empty members
package "诊后要求的提出、发布及跟进" as R {
' @reference patient
class "患者" as patient_r <<entity>>
' @reference visit
class "就诊" as visit_r <<entity>>
' @reference plan_version
class "方案版本" as plan_r <<entity>>
class "诊后要求" as followup_requirement <<entity>> {
 类型、目的、目标起止日期
 是否需临床评估、负责前台
 要求状态、下次联系日期
 发布及变更依据、完成或撤销人和时间
 --
 +核对患者与诊疗来源()
 +暂存或发布要求()
 +调整未完成要求(原因)
 +撤销要求(牙医依据)
 +安排继续跟进(日期与责任人)
 +核对目的达成及完成依据()
}
patient_r "1" -- "0..*" followup_requirement
visit_r "0..1" -- "0..*" followup_requirement
plan_r "0..1" -- "0..*" followup_requirement
patient_r -[hidden]right- visit_r
visit_r -[hidden]right- plan_r
note bottom of followup_requirement
来源就诊或方案版本至少一项，均属本患者。
发布仅产生待办；未联系、拒绝、未到不自动完成。
调整及撤销保留原历史，不直接取消既有预约。
end note
}
@enduml
