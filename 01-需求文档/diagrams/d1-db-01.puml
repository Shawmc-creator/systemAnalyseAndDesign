@startuml d1-db-01
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 15
skinparam backgroundColor white
skinparam shadowing false
skinparam classAttributeIconSize 0
hide circle
hide empty methods
skinparam classFontSize 17
skinparam classAttributeFontSize 15
skinparam ArrowColor #667788
skinparam ArrowThickness 1
skinparam nodesep 55
skinparam ranksep 75
skinparam linetype polyline
top to bottom direction
skinparam class {
 BackgroundColor white
 BorderColor #526575
 HeaderBackgroundColor #EDF5FA
}
title G01  患者与职员  ·  5张表
entity "患者\npatient" as patient {
  {field} id : INTEGER [PK, NN]
  {field} name : TEXT [NN]
  {field} birth_date : TEXT [NULL]
  {field} phone : TEXT [NULL]
  {field} phone_owner : TEXT [NULL]
  {field} address : TEXT [NULL]
  {field} contact_preference : TEXT [NULL]
  {field} contact_unavailable_reason : TEXT [NULL]
  {field} created_by : INTEGER [FK, NN]  → staff.id
  {field} record_no : TEXT [UQ, NN]
  {field} created_at : TEXT [NN]
  {field} updated_at : TEXT [NN]
  {field} revision : INTEGER [NN]
}
entity "职员\nstaff" as staff {
  {field} id : INTEGER [PK, NN]
  {field} name : TEXT [NN]
  {field} employed_from : TEXT [NN]
  {field} employed_until : TEXT [NULL]
  {field} created_by : INTEGER [FK, NULL]  → staff.id
  {field} record_no : TEXT [UQ, NN]
  {field} created_at : TEXT [NN]
  {field} updated_at : TEXT [NN]
  {field} revision : INTEGER [NN]
}
entity "患者资料变更\npatient_change" as patient_change {
  {field} id : INTEGER [PK, NN]
  {field} patient_id : INTEGER [FK, NN]  → patient.id
  {field} old_value : TEXT [NULL]
  {field} new_value : TEXT [NULL]
  {field} reason : TEXT [NN]
  {field} occurred_at : TEXT [NN]
  {field} field_name : TEXT [NN]
  {field} operator_id : INTEGER [FK, NN]  → staff.id
  {field} created_at : TEXT [NN]
  {field} updated_at : TEXT [NN]
  {field} revision : INTEGER [NN]
}
entity "代理关系\npatient_proxy" as patient_proxy {
  {field} id : INTEGER [PK, NN]
  {field} patient_id : INTEGER [FK, NN]  → patient.id
  {field} proxy_name : TEXT [NN]
  {field} relationship : TEXT [NN]
  {field} scope : TEXT [NN]
  {field} valid_from : TEXT [NN]
  {field} valid_until : TEXT [NULL]
  {field} verification_basis : TEXT [NN]
  {field} verified_by : INTEGER [FK, NN]  → staff.id
  {field} created_at : TEXT [NN]
  {field} updated_at : TEXT [NN]
  {field} revision : INTEGER [NN]
}
entity "接诊交接\nclinical_handover" as clinical_handover {
  {field} id : INTEGER [PK, NN]
  {field} patient_id : INTEGER [FK, NN]  → patient.id
  {field} receiving_dentist_id : INTEGER [FK, NN]  → staff.id
  {field} handover_by : INTEGER [FK, NN]  → staff.id
  {field} scope : TEXT [NN]
  {field} valid_from : TEXT [NN]
  {field} valid_until : TEXT [NULL]
  {field} reason : TEXT [NN]
  {field} created_at : TEXT [NN]
  {field} updated_at : TEXT [NN]
  {field} revision : INTEGER [NN]
}
clinical_handover --> patient
patient_change --> patient
patient_proxy --> patient
patient -[hidden]right- staff
@enduml
