@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SimSun
skinparam defaultFontSize 17
skinparam dpi 200
skinparam ArrowColor black
skinparam NoteBackgroundColor white
skinparam NoteBorderColor black
skinparam ActorBackgroundColor white
skinparam BoundaryBackgroundColor white
skinparam ControlBackgroundColor white
hide footbox
skinparam maxMessageSize 200
skinparam sequenceMessageAlign center
skinparam sequence {
 ParticipantBackgroundColor white
 ParticipantBorderColor black
 LifeLineBorderColor black
 LifeLineBackgroundColor white
 ArrowColor black
 GroupBackgroundColor white
 GroupBorderColor black
}
actor "诊疗助理" as A0
boundary "<u>:诊疗助理接口</u>" as B0
control "<u>:查询材料与批次</u>\n<u>库存控制</u>" as K
participant "<u>:材料</u>" as Material
participant "<u>:材料批次</u>" as Batch
participant "<u>:批次存量</u>" as Stock
participant "<u>:库存变动</u>" as Movement
participant "<u>:实际用料</u>" as Usage
A0 -> B0 : 查询UC-17办理依据
activate B0
B0 -> B0 : 检查输入格式()
B0 -> K : 协调UC-17办理(对象、依据)
activate K
K -> Material : 定位材料及单位(材料筛选)
activate Material
Material --> K : 处理结果或拒绝原因
deactivate Material
K -> Batch : 提供批次可用性(批号、效期及停用依据)
activate Batch
Batch --> K : 处理结果或拒绝原因
deactivate Batch
K -> Stock : 提供分处余额(批次、位置)
activate Stock
Stock -> Movement : 提供收发依据(查询期间)
activate Movement
Movement -> Usage : 提供实际使用(获准追溯范围)
activate Usage
Usage --> Movement : 处理结果或拒绝原因
deactivate Usage
Movement --> Stock : 处理结果或拒绝原因
deactivate Movement
Stock --> K : 处理结果或拒绝原因
deactivate Stock
K --> B0 : 本阶段结果及下一步依据
deactivate K
B0 --> A0 : 展示结果、状态和原因
deactivate B0
note over K,Usage
校验不通过时返回规约中的原因；
本阶段不留下部分有效结果。
end note

@enduml
