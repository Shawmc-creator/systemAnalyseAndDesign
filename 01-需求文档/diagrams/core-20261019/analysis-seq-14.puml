@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SimSun
skinparam defaultFontSize 17
skinparam ArrowColor black
skinparam ClassBackgroundColor white
skinparam ActorBackgroundColor white
skinparam BoundaryBackgroundColor white
skinparam ControlBackgroundColor white
skinparam EntityBackgroundColor white
skinparam NoteBackgroundColor white
skinparam NoteBorderColor black
skinparam classAttributeIconSize 0
skinparam nodesep 24
skinparam ranksep 34
hide footbox
autonumber
skinparam maxMessageSize 120
actor "收费人员" as A
boundary "收费人员接口" as B
control "办理费用更正与\n退费控制" as K
entity "费用申请" as E0
entity "费用调整" as E1
entity "退款办理" as E2
actor "诊所负责人" as M
boundary "负责人接口" as BM
A -> B : 办理费用更正与退费
B -> K : 提交对象编号及办理内容
activate K
K -> K : 核对岗位权限与必要资料
alt 可以办理
K -> E0 : 核对原账单付款并保存申请
activate E0
E0 --> K : 待审核的费用申请
deactivate E0
K --> BM : 提供待审核内容及来源
M -> BM : 核实并记录审核意见
BM -> K : 提交负责人意见
K -> E0 : 按负责人意见确认处理范围
activate E0
E0 --> K : 批准或退回的结果
deactivate E0
alt 负责人批准
K -> E1 : 按批准范围形成费用更正
activate E1
E1 --> K : 调整后的应收金额
deactivate E1
K --> B : 显示批准范围及可退金额
A -> B : 完成实际退款后登记凭据
B -> K : 提交真实退款结果
K -> E2 : 核对可退金额并登记实际退回
activate E2
E2 --> K : 实退金额及原付款关联
deactivate E2
else 未批准或需要补充
K --> B : 保留申请及意见，不更正费用或退费
end
K --> B : 返回本次结果
else 权限资料或状态不符合
K --> B : 返回核对原因且不改变原记录
end
B --> A : 展示结果
deactivate K

@enduml
