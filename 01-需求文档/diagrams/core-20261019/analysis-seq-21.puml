@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SimSun
skinparam defaultFontSize 17
skinparam ArrowColor black
skinparam ClassBackgroundColor white
skinparam ActorBackgroundColor white
skinparam BoundaryBackgroundColor white
skinparam ControlBackgroundColor white
skinparam EntityBackgroundColor white
skinparam NoteBackgroundColor white
skinparam NoteBorderColor black
skinparam classAttributeIconSize 0
skinparam nodesep 24
skinparam ranksep 34
hide footbox
autonumber
skinparam maxMessageSize 120
actor "收费人员" as A
boundary "收费人员接口" as B
control "查询日常经营与\n收款统计控制" as K
entity "就诊" as E0
entity "应收账目" as E1
entity "患者付款" as E2
entity "退款办理" as E3
A -> B : 查询日常经营与收款统计
B -> K : 提交对象编号及办理内容
activate K
K -> K : 核对岗位权限与必要资料
alt 可以办理
K -> E0 : 按日期统计实际接诊
activate E0
E0 --> K : 接诊量
deactivate E0
K -> E1 : 汇总应收及未付
activate E1
E1 --> K : 应收和欠费金额
deactivate E1
K -> E2 : 汇总实际到账且不重复计抵扣
activate E2
E2 --> K : 实际收款
deactivate E2
K -> E3 : 汇总实际退回并保留原单入口
activate E3
E3 --> K : 退款及净收统计
deactivate E3
K --> B : 返回本次结果
else 权限资料或状态不符合
K --> B : 返回核对原因且不改变原记录
end
B --> A : 展示结果
deactivate K

@enduml
