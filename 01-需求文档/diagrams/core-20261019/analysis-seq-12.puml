@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SimSun
skinparam defaultFontSize 17
skinparam ArrowColor black
skinparam ClassBackgroundColor white
skinparam ActorBackgroundColor white
skinparam BoundaryBackgroundColor white
skinparam ControlBackgroundColor white
skinparam EntityBackgroundColor white
skinparam NoteBackgroundColor white
skinparam NoteBorderColor black
skinparam classAttributeIconSize 0
skinparam nodesep 24
skinparam ranksep 34
hide footbox
autonumber
skinparam maxMessageSize 120
actor "收费人员" as A
boundary "收费人员接口" as B
control "查询账单与待结\n算费用控制" as K
entity "应收账目" as E0
entity "应收项目" as E1
entity "费用调整" as E2
entity "付款分配" as E3
A -> B : 查询账单与待结算费用
B -> K : 提交对象编号及办理内容
activate K
K -> K : 核对岗位权限与必要资料
alt 可以办理
K -> E0 : 查找患者账单
activate E0
E0 --> K : 账单及期间
deactivate E0
K -> E1 : 读取实际项目及计费金额
activate E1
E1 --> K : 项目明细
deactivate E1
K -> E2 : 读取有效费用调整
activate E2
E2 --> K : 调整后应收
deactivate E2
K -> E3 : 汇总付款用途与未付金额
activate E3
E3 --> K : 已付及未付明细
deactivate E3
K --> B : 返回本次结果
else 权限资料或状态不符合
K --> B : 返回核对原因且不改变原记录
end
B --> A : 展示结果
deactivate K

@enduml
