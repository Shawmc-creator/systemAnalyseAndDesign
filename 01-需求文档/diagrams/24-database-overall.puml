  {field} occurred_at : TEXT [NN]
  {field} field_name : TEXT [NN]
  {field} operator_id : INTEGER [FK, NN]  → staff.id
  {field} created_at : TEXT [NN]
  {field} updated_at : TEXT [NN]
  {field} revision : INTEGER [NN]
}
entity "代理关系\npatient_proxy" as patient_proxy {
  {field} id : INTEGER [PK, NN]
  {field} patient_id : INTEGER [FK, NN]  → patient.id
  {field} proxy_name : TEXT [NN]
  {field} relationship : TEXT [NN]
  {field} scope : TEXT [NN]
  {field} valid_from : TEXT [NN]
  {field} valid_until : TEXT [NULL]
  {field} verification_basis : TEXT [NN]
  {field} verified_by : INTEGER [FK, NN]  → staff.id
  {field} created_at : TEXT [NN]
  {field} updated_at : TEXT [NN]
  {field} revision : INTEGER [NN]
}
entity "接诊交接\nclinical_handover" as clinical_handover {
  {field} id : INTEGER [PK, NN]
  {field} patient_id : INTEGER [FK, NN]  → patient.id
  {field} receiving_dentist_id : INTEGER [FK, NN]  → staff.id
  {field} handover_by : INTEGER [FK, NN]  → staff.id
  {field} scope : TEXT [NN]
  {field} valid_from : TEXT [NN]
  {field} valid_until : TEXT [NULL]
  {field} reason : TEXT [NN]
  {field} created_at : TEXT [NN]
  {field} updated_at : TEXT [NN]
  {field} revision : INTEGER [NN]
}
clinical_handover --> patient
patient_change --> patient
patient_proxy --> patient
patient -[hidden]right- staff
@enduml

