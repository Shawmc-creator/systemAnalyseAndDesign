}
entity "患者资料变更\npatient_change" as patient_change {
  {field} id : INTEGER [PK, NN]
  {field} patient_id : INTEGER [FK, NN]  → patient.id
  {field} old_value : TEXT [NULL]
  {field} new_value : TEXT [NULL]
