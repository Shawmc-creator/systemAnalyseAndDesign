@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SimSun
skinparam defaultFontSize 18
skinparam dpi 220
skinparam ArrowColor black
hide footbox
skinparam sequenceMessageAlign center
skinparam ActorBorderColor black
skinparam ActorBackgroundColor white
skinparam sequence {
 ParticipantBorderColor transparent
 ParticipantBackgroundColor white
 LifeLineBorderColor black
 LifeLineBackgroundColor white
 ArrowColor black
 ActivationBorderColor black
 ActivationBackgroundColor white
}
participant "<img:business-worker.png>\n诊所负责人" as M
participant "<img:business-worker.png>\n收费人员" as C
participant "<img:business-worker.png>\n牙医" as D
participant "<img:business-entity.png>\n牙科诊所管理系统" as S
M -> C : 确认项目、价格及适用时间
activate C
C -> S : 提交价目版本及确认依据
S -> S : 核对完整性及适用区间
alt 价目有效
 S --> C : 返回有效版本
 C -> D : 告知价目变化
 D -> S : 查询适用价目
 S --> D : 返回项目价格及适用时间
else 内容有误或区间重叠
 S --> C : 返回原因并保留原价目
end
opt 个别费用需要调整
 C -> M : 提交调整原因及依据
 M --> C : 确认处理意见
 C -> S : 登记调整并关联原费用
 S --> C : 返回调整结果，原依据保留
end
deactivate C
@enduml
