@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SimSun
skinparam defaultFontSize 17
skinparam ArrowColor black
skinparam classBackgroundColor white
skinparam classBorderColor black
skinparam classAttributeIconSize 0
skinparam linetype polyline
hide empty members

left to right direction
skinparam nodesep 65
skinparam ranksep 95
class "患者" as Patient <<entity>> {
 -id: ObjectId
 -name: Text
 -birth_date: Text?
 -phone: Text?
 -phone_owner: Text?
 +核对身份(依据: 操作输入): 业务结果
 +核对身份候选(依据: 操作输入): 业务结果
 +确认资料维护(依据: 操作输入): 业务结果
 +核对临床访问(依据: 操作输入): 业务结果
 +确认健康变更(依据: 操作输入): 业务结果
}
class "就诊" as Visit <<entity>> {
 -id: ObjectId
 -arrived_at: Text
 -started_at: Text?
 -ended_at: Text?
 -arrival_source: Text
 +登记到诊(依据: 操作输入): 业务结果
 +核对接诊责任(依据: 操作输入): 业务结果
 +确认实际执行(依据: 操作输入): 业务结果
 +提供获准就诊(依据: 操作输入): 业务结果
 +确认实际接诊(依据: 操作输入): 业务结果
 +记录检查诊断(依据: 操作输入): 业务结果
 +核对签署条件(依据: 操作输入): 业务结果
 +结束本次诊疗(依据: 操作输入): 业务结果
 +提供诊后来源(依据: 操作输入): 业务结果
 +提供本次复诊依据(依据: 操作输入): 业务结果
 +汇总诊疗发生(依据: 操作输入): 业务结果
 +确认当次复核(依据: 操作输入): 业务结果
 +核对使用归属(依据: 操作输入): 业务结果
 +追加病历说明(依据: 操作输入): 业务结果
 +提供获准追查信息(依据: 操作输入): 业务结果
}
class "治疗方案" as Plan <<entity>> {
 -id: ObjectId
 -goal: Text
 -established_at: Text
 -termination_reason: Text?
 -closed_at: Text?
 +核对执行依据(依据: 操作输入): 业务结果
 +提供版本及执行依据(依据: 操作输入): 业务结果
 +提供诊后方案依据(依据: 操作输入): 业务结果
 +提出方案草稿(依据: 操作输入): 业务结果
 +确认患者决定(依据: 操作输入): 业务结果
 +提出剩余项目改版(依据: 操作输入): 业务结果
 +确认整体完成或终止(依据: 操作输入): 业务结果
}
class "方案版本" as PlanVersion <<entity>> {
 -id: ObjectId
 -diagnostic_basis: Text
 -explained_at: Text?
 -change_reason: Text
 -planned_schedule: Text
 +核对确认版本(依据: 操作输入): 业务结果
 +提供确认来源(依据: 操作输入): 业务结果
 +形成待确认版本(依据: 操作输入): 业务结果
 +提交方案说明(依据: 操作输入): 业务结果
 +登记确认经历(依据: 操作输入): 业务结果
 +保留原确认版本(依据: 操作输入): 业务结果
 +重新说明方案(依据: 操作输入): 业务结果
 +停止后续安排(依据: 操作输入): 业务结果
 +核对本版完成(依据: 操作输入): 业务结果
}
class "方案项目" as PlanItem <<entity>> {
 -id: ObjectId
 -item_description: Text
 -tooth_code: Text?
 -surface_code: Text?
 -planned_quantity: Int64
 +核对可执行范围(依据: 操作输入): 业务结果
 +组织计划明细(依据: 操作输入): 业务结果
 +识别未执行范围(依据: 操作输入): 业务结果
}
class "患者决定" as Decision <<entity>> {
 -id: ObjectId
 -decision: Text
 -decided_at: Text
 -explanation_basis: Text
 -scope_note: Text
 +保留患者决定(依据: 操作输入): 业务结果
}
class "诊疗执行" as Execution <<entity>> {
 -id: ObjectId
 -tooth_code: Text?
 -surface_code: Text?
 -completed_quantity: Int64
 -procedure_note: Text
 +保留执行依据(依据: 操作输入): 业务结果
 +核对已完成事实(依据: 操作输入): 业务结果
}
class "收费项目" as Service <<entity>> {
 -id: ObjectId
 -name: Text
 -billing_unit: Text
 -is_active: Int64
 -record_no: Text
 +提出新价目(依据: 操作输入): 业务结果
 +确认价目发布(依据: 操作输入): 业务结果
}
Patient "1" -- "0..*" Visit : 就诊者
Patient "1" -- "0..*" Plan : 持续方案
Plan "1" *-- "1..*" PlanVersion : 方案版本
PlanVersion "1" *-- "1..*" PlanItem : 计划明细
PlanVersion "1" *-- "0..*" Decision : 确认经历
Decision "0..*" -- "1..*" PlanItem : 确认范围
Visit "1" *-- "0..*" Execution : 实际完成
PlanItem "0..1" -- "0..*" Execution : 所据计划
Service "1" -- "0..*" Execution : 实际项目
Execution "0..1" -- "0..*" Execution : 原执行与更正
Visit "0..1" -- "0..*" PlanVersion : 内部诊断来源
@enduml