@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SimSun
skinparam defaultFontSize 17
skinparam ArrowColor black
skinparam ClassBackgroundColor white
skinparam ActorBackgroundColor white
skinparam BoundaryBackgroundColor white
skinparam ControlBackgroundColor white
skinparam EntityBackgroundColor white
skinparam NoteBackgroundColor white
skinparam NoteBorderColor black
skinparam classAttributeIconSize 0
skinparam nodesep 24
skinparam ranksep 34
hide footbox
autonumber
skinparam maxMessageSize 145
actor "前台／收费人员" as A
boundary "医保办理接口" as B
control "核验医保身份\n并办理预结算控制" as C
entity "医保身份核验" as I
entity "医保就诊办理" as F
boundary "医保服务接口" as E
actor "医保平台" as X
A -> B : 提交患者就诊及必要身份信息
B -> C : 核对机构条件与办理资料
C -> F : 建立或查回当次办理及原业务号
C -> E : 核验参保身份并登记就诊
E -> X : 办理核验登记
X --> E : 真实核验及登记结果
E --> C : 身份和适用条件
opt 已取得明确身份核验结果
 C -> I : 保存实际核验结果
 C -> F : 关联身份与真实办理状态
end
alt 条件符合
 C -> F : 核对诊断编码、原费用及项目对应
 C -> E : 上传费用并申请预结算
 E -> X : 办理费用核对及预结算
 X --> E : 基金、个账和其他自付预估
 E --> C : 返回平台实际结果
 alt 取得有效预结算
 C -> F : 保存本次预结算结果
 C --> B : 展示基金、个账、其他自付及自费项目
 B --> A : 交由工作人员向患者说明
 A -> B : 根据患者实际选择确认或暂缓
 B -> C : 提交患者选择及确认依据
 C -> F : 保存实际选择与确认时间
 else 预结算未完成或结果未知
  C -> F : 保留原业务及未完成状态
  C --> B : 核实或补正后再办理，不确认分摊
 end
else 不符合或结果未知
 C -> F : 保留原办理状态与核实依据
 C --> B : 说明原因，补充或核实原笔
end
C --> B : 返回后续可办理事项
B --> A : 展示并向患者说明

@enduml
