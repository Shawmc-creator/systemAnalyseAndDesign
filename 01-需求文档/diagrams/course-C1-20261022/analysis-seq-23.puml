@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SimSun
skinparam defaultFontSize 17
skinparam ArrowColor black
skinparam ClassBackgroundColor white
skinparam ActorBackgroundColor white
skinparam BoundaryBackgroundColor white
skinparam ControlBackgroundColor white
skinparam EntityBackgroundColor white
skinparam NoteBackgroundColor white
skinparam NoteBorderColor black
skinparam classAttributeIconSize 0
skinparam nodesep 24
skinparam ranksep 34
hide footbox
autonumber
skinparam maxMessageSize 145
actor "收费人员／负责人" as A
boundary "医保结算接口" as B
control "办理医保结算、撤销\n与回款核对控制" as C
entity "医保结算" as S
entity "医保撤销办理" as R
entity "医保结算款收付" as F
boundary "医保服务接口" as E
A -> B : 选择正式结算、撤销或回款核对
B -> C : 提交原办理与核实依据
alt 正式结算
 C -> E : 核对有效预结算并办理原笔
 E --> C : 正式分摊、结算号或待核实
 alt 核实正式结算成功
  C -> S : 保存正式分摊和结算编号
  C --> B : 返回最终患者其他待付
 else 未成功或仍待核实
  C --> B : 保留未完成状态，查原笔或纠正后办理
 end
else 撤销或冲正
 C -> R : 记录原结算和处理依据
 C -> E : 按当地规则办理并查询原笔
 E --> C : 撤销成功、失败或未知
 C -> R : 保留真实办理结果
 alt 核实撤销或冲正成功
  C -> S : 更新原结算有效性，保留历史
 else 未成功或仍待核实
  C --> B : 原结果待处理，不确认已撤销
 end
else 实际医保款核对
 C -> S : 读取有效结算承担额与原收付
 C -> F : 根据真实凭据记录拨付或退回
 F --> C : 实际收付及尚待核对金额
end
C --> B : 返回独立的医保状态与资金结果
B --> A : 展示并形成后续待办

@enduml
