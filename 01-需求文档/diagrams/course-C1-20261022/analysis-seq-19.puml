@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SimSun
skinparam defaultFontSize 17
skinparam ArrowColor black
skinparam ClassBackgroundColor white
skinparam ActorBackgroundColor white
skinparam BoundaryBackgroundColor white
skinparam ControlBackgroundColor white
skinparam EntityBackgroundColor white
skinparam NoteBackgroundColor white
skinparam NoteBorderColor black
skinparam classAttributeIconSize 0
skinparam nodesep 24
skinparam ranksep 34
hide footbox
autonumber
skinparam maxMessageSize 120
actor "诊疗助理" as A
boundary "诊疗助理接口" as B
control "登记基础采购\n与到货验收控制" as K
entity "采购" as E0
entity "验收" as E1
entity "验收项目" as E2
entity "批次存量" as E3
A -> B : 登记基础采购与到货验收
B -> K : 提交对象编号及办理内容
activate K
K -> K : 核对岗位权限与必要资料
alt 可以办理
K -> E0 : 提出并确认采购内容
activate E0
E0 --> K : 已确认采购单
deactivate E0
K -> E1 : 登记实际到货验收
activate E1
E1 --> K : 本次验收编号
deactivate E1
K -> E2 : 记录合格量及批次归属
activate E2
E2 --> K : 合格及待处理明细
deactivate E2
K -> E3 : 按本次合格量增加批次库存
activate E3
E3 --> K : 验收后库存余额
deactivate E3
K --> B : 返回本次结果
else 权限资料或状态不符合
K --> B : 返回核对原因且不改变原记录
end
B --> A : 展示结果
deactivate K

@enduml
