@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SimSun
skinparam defaultFontSize 17
skinparam ArrowColor black
skinparam ClassBackgroundColor white
skinparam ActorBackgroundColor white
skinparam BoundaryBackgroundColor white
skinparam ControlBackgroundColor white
skinparam EntityBackgroundColor white
skinparam NoteBackgroundColor white
skinparam NoteBorderColor black
skinparam classAttributeIconSize 0
skinparam nodesep 24
skinparam ranksep 34
hide footbox
autonumber
skinparam maxMessageSize 120
actor "牙医" as A
boundary "牙医接口" as B
control "记录检查诊断与\n健康资料控制" as K
entity "就诊" as E0
entity "健康复核" as E1
entity "检查所见" as E2
entity "病历" as E3
A -> B : 记录检查诊断与健康资料
B -> K : 提交对象编号及办理内容
activate K
K -> K : 核对岗位权限与必要资料
alt 可以办理
K -> E0 : 核对并开始实际接诊
activate E0
E0 --> K : 接诊中状态
deactivate E0
K -> E1 : 保存本次病史与过敏复核
activate E1
E1 --> K : 复核结果
deactivate E1
K -> E2 : 记录牙位和检查所见
activate E2
E2 --> K : 检查记录
deactivate E2
K -> E3 : 保存主诉诊断与处理意见
activate E3
E3 --> K : 病历草稿
deactivate E3
K --> B : 返回本次结果
else 权限资料或状态不符合
K --> B : 返回核对原因且不改变原记录
end
B --> A : 展示结果
deactivate K

@enduml
