@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SimSun
skinparam defaultFontSize 17
skinparam ArrowColor black
skinparam ClassBackgroundColor white
skinparam ActorBackgroundColor white
skinparam BoundaryBackgroundColor white
skinparam ControlBackgroundColor white
skinparam EntityBackgroundColor white
skinparam NoteBackgroundColor white
skinparam NoteBorderColor black
skinparam classAttributeIconSize 0
skinparam nodesep 24
skinparam ranksep 34
hide footbox
autonumber
skinparam maxMessageSize 120
actor "前台" as A
boundary "前台接口" as B
control "登记到诊控制" as K
entity "预约" as E0
entity "接诊占用" as E1
entity "就诊" as E2
entity "病历" as E3
A -> B : 登记到诊
B -> K : 提交对象编号及办理内容
activate K
K -> K : 核对岗位权限与必要资料
alt 可以办理
K -> E0 : 查找预约并核对是否已到诊
activate E0
E0 --> K : 预约及到诊状态
deactivate E0
K -> E1 : 确认本次接诊安排
activate E1
E1 --> K : 无冲突的接诊资源
deactivate E1
K -> E2 : 登记本次实际到诊
activate E2
E2 --> K : 就诊编号及候诊状态
deactivate E2
K -> E3 : 建立当次病历草稿
activate E3
E3 --> K : 草稿编号
deactivate E3
K --> B : 返回本次结果
else 权限资料或状态不符合
K --> B : 返回核对原因且不改变原记录
end
B --> A : 展示结果
deactivate K

@enduml
