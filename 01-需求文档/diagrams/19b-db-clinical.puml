@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 15
skinparam dpi 180
skinparam linetype ortho
skinparam nodesep 45
skinparam ranksep 55
skinparam ArrowColor #526575
skinparam classAttributeIconSize 0
skinparam class {
 BackgroundColor #FFFFFF
 BorderColor #34495E
 BorderThickness 1.3
 HeaderBackgroundColor #EAF1F7
 FontColor #172B3A
}
hide circle
hide methods
top to bottom direction
entity "患者\npatient" as patient {
 id [PK]
 --
 姓名
 联系电话
 出生日期
}
entity "患者资料变更\npatient_change" as patient_change {
 id [PK]
 --
 patient_id [FK]
 operator_id [FK: staff]
 发生时间
 原值
 原因
}
entity "就诊\nvisit" as visit {
 id [PK]
 --
 appointment_id [FK, UQ]
 patient_id [FK]
 registered_by [FK: staff]
 current_confirmation_id [FK, UQ, 可空]
 到诊时间
}
entity "病历\nclinical_record" as clinical_record {
 id [PK]
 --
 visit_id [FK, UQ]
 signed_by [FK: staff, 可空]
 主诉
 诊断
 签署时间
}
entity "检查所见\nclinical_finding" as clinical_finding {
 id [PK]
 --
 record_id [FK]
 牙位
 检查描述
}
entity "病历补充\nrecord_addendum" as record_addendum {
 id [PK]
 --
 record_id [FK]
 author_id [FK: staff]
 发生时间
 内容
 原因
}
entity "诊疗方案\ntreatment_plan" as treatment_plan {
 id [PK]
 --
 record_id [FK]
 说明时间
 方案说明
}
entity "方案项目\nplan_item" as plan_item {
 id [PK]
 --
 plan_id [FK]
 service_id [FK]
 牙位
 预计数量
 患者决定
}
entity "收费项目\nservice" as service {
 id [PK]
 --
 名称
 计价单位
}
patient ||--o{ patient_change
patient ||--o{ visit
visit ||--|| clinical_record
clinical_record ||--o{ clinical_finding
clinical_record ||--o{ record_addendum
clinical_record ||--o{ treatment_plan
treatment_plan ||--|{ plan_item
service ||--o{ plan_item
@enduml
