@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SimSun
skinparam defaultFontSize 17
skinparam ArrowColor black
skinparam classBackgroundColor white
skinparam classBorderColor black
skinparam classAttributeIconSize 0
skinparam linetype polyline
hide empty members

left to right direction
skinparam nodesep 65
skinparam ranksep 95
class "患者" as Patient <<entity>> {
 -id: ObjectId
 -name: Text
 -birth_date: Text?
 -phone: Text?
 -phone_owner: Text?
 +核对身份(依据: 操作输入): 业务结果
 +核对身份候选(依据: 操作输入): 业务结果
 +确认资料维护(依据: 操作输入): 业务结果
 +核对临床访问(依据: 操作输入): 业务结果
 +确认健康变更(依据: 操作输入): 业务结果
}
class "职员" as Staff <<entity>> {
 -id: ObjectId
 -name: Text
 -employed_from: Text
 -employed_until: Text?
 -record_no: Text
 +核对在岗与职责(依据: 操作输入): 业务结果
}
class "诊椅" as Chair <<entity>> {
 -id: ObjectId
 -name: Text
 -available_from: Text
 -available_until: Text?
 -record_no: Text
 +核对可用区间(依据: 操作输入): 业务结果
 +确认可用范围(依据: 操作输入): 业务结果
}
class "日期安排" as Schedule <<entity>> {
 -id: ObjectId
 -business_date: Text
 -starts_at: Text
 -ends_at: Text
 -confirmed_at: Text?
 +申请预约占用(依据: 操作输入): 业务结果
 +确认到诊占用(依据: 操作输入): 业务结果
 +核对拟发布安排(依据: 操作输入): 业务结果
 +确认日期安排(依据: 操作输入): 业务结果
 +提供可用组合(依据: 操作输入): 业务结果
 +形成可用区间(依据: 操作输入): 业务结果
 +重新安排或释放(依据: 操作输入): 业务结果
 +确认指定日期停诊(依据: 操作输入): 业务结果
}
class "安排变更" as ScheduleChange <<entity>> {
 -id: ObjectId
 -old_business_date: Text
 -old_starts_at: Text
 -old_ends_at: Text
 -new_business_date: Text
 +保留日期例外(依据: 操作输入): 业务结果
}
class "接诊占用" as Occupancy <<entity>> {
 -id: ObjectId
 -starts_at: Text
 -ends_at: Text
 -released_at: Text?
 -arrangement_revision: Int64
 +检查并占用(依据: 操作输入): 业务结果
 +关联到诊(依据: 操作输入): 业务结果
 +排除已有占用(依据: 操作输入): 业务结果
 +调整有效占用(依据: 操作输入): 业务结果
}
class "预约" as Appointment <<entity>> {
 -id: ObjectId
 -planned_start: Text
 -planned_end: Text
 -reason: Text
 -due_at: Text
 +确认安排(依据: 操作输入): 业务结果
 +提供安排及经历(依据: 操作输入): 业务结果
 +核对到诊来源(依据: 操作输入): 业务结果
 +关联到诊结果(依据: 操作输入): 业务结果
 +核对复诊关联(依据: 操作输入): 业务结果
 +列出受影响安排(依据: 操作输入): 业务结果
 +核对可变更性(依据: 操作输入): 业务结果
 +变更或取消安排(依据: 操作输入): 业务结果
 +标记受影响安排(依据: 操作输入): 业务结果
 +核对后续处理(依据: 操作输入): 业务结果
 +确认未到事实(依据: 操作输入): 业务结果
}
class "预约变更" as AppointmentChange <<entity>> {
 -id: ObjectId
 -old_start: Text
 -old_end: Text
 -old_revision: Int64
 -new_start: Text?
 +保留变更(依据: 操作输入): 业务结果
}
class "就诊" as Visit <<entity>> {
 -id: ObjectId
 -arrived_at: Text
 -started_at: Text?
 -ended_at: Text?
 -arrival_source: Text
 +登记到诊(依据: 操作输入): 业务结果
 +核对接诊责任(依据: 操作输入): 业务结果
 +确认实际执行(依据: 操作输入): 业务结果
 +提供获准就诊(依据: 操作输入): 业务结果
 +确认实际接诊(依据: 操作输入): 业务结果
 +记录检查诊断(依据: 操作输入): 业务结果
 +核对签署条件(依据: 操作输入): 业务结果
 +结束本次诊疗(依据: 操作输入): 业务结果
 +提供诊后来源(依据: 操作输入): 业务结果
 +提供本次复诊依据(依据: 操作输入): 业务结果
 +汇总诊疗发生(依据: 操作输入): 业务结果
 +确认当次复核(依据: 操作输入): 业务结果
 +核对使用归属(依据: 操作输入): 业务结果
 +追加病历说明(依据: 操作输入): 业务结果
 +提供获准追查信息(依据: 操作输入): 业务结果
}
Staff "1" -- "0..*" Schedule : 接诊牙医
Chair "1" -- "0..*" Schedule : 使用诊椅
Schedule "1" *-- "0..*" ScheduleChange : 安排经历
Schedule "1" -- "0..*" Occupancy : 支持日期
Appointment "0..1" -- "0..*" Occupancy : 预约来源
Visit "0..1" -- "0..*" Occupancy : 现场或到诊关联
Patient "1" -- "0..*" Appointment : 预约者
Appointment "1" *-- "0..*" AppointmentChange : 变更经历
Patient "1" -- "0..*" Visit : 就诊者
Appointment "0..1" -- "0..1" Visit : 来源预约
Staff "1" -- "0..*" Visit : 责任牙医
@enduml