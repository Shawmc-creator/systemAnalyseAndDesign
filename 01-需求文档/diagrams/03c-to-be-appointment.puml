@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SimSun
skinparam defaultFontSize 18
skinparam dpi 220
skinparam ArrowColor black
hide footbox
skinparam sequenceMessageAlign center
skinparam ActorBorderColor black
skinparam ActorBackgroundColor white
skinparam sequence {
 ParticipantBorderColor transparent
 ParticipantBackgroundColor white
 LifeLineBorderColor black
 LifeLineBackgroundColor white
 ArrowColor black
 ActivationBorderColor black
 ActivationBackgroundColor white
}
actor "患者" as P
participant "<img:business-worker.png>\n前台" as F
participant "<img:business-worker.png>\n牙医" as D
participant "<img:business-entity.png>\n牙科诊所管理系统" as S
P -> F : 提出预约或变更需求
activate F
F -> S : 查询患者及指定日期可用安排
S --> F : 返回牙医、诊椅及可用时间
opt 需调整接诊条件
 F -> D : 核实临时接诊安排
 D --> F : 给出已协调的安排依据
end
F -> P : 提供可选时间和接诊说明
P --> F : 确认选择
F -> S : 提交预约或变更及确认依据
activate S
S -> S : 核对日期安排、资源占用\n保留原预约和变更历史
alt 符合安排
 S --> F : 返回有效预约及变更结果
 F --> P : 告知确认结果
else 冲突或安排已变化
 S --> F : 返回原因，保留原有效安排
 F -> P : 重新协商时间
end
deactivate S
opt 患者取消已有预约
 P -> F : 提出取消
 F -> S : 登记取消原因并释放占用
 S --> F : 返回取消结果
 F --> P : 确认取消
end
deactivate F
@enduml
