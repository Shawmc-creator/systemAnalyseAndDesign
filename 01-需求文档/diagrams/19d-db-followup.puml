@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 15
skinparam dpi 180
skinparam linetype ortho
skinparam nodesep 45
skinparam ranksep 55
skinparam ArrowColor #526575
skinparam classAttributeIconSize 0
skinparam class {
 BackgroundColor #FFFFFF
 BorderColor #34495E
 BorderThickness 1.3
 HeaderBackgroundColor #EAF1F7
 FontColor #172B3A
}
hide circle
hide methods
top to bottom direction
entity "就诊\nvisit" as visit {
 id [PK]
 --
 appointment_id [FK, UQ]
 patient_id [FK]
 registered_by [FK: staff]
 current_confirmation_id [FK, UQ, 可空]
 到诊时间
}
entity "诊后要求\nfollowup_requirement" as followup_requirement {
 id [PK]
 --
 source_visit_id [FK]
 current_appointment_id [FK, 可空]
 requested_by [FK: staff]
 assigned_frontdesk_id [FK: staff]
 类型
 目标日期
}
entity "联系经历\ncontact_history" as contact_history {
 id [PK]
 --
 requirement_id [FK]
 appointment_id [FK, 可空]
 operator_id [FK: staff]
 联系时间
 反馈
}
entity "临床评估\nclinical_assessment" as clinical_assessment {
 id [PK]
 --
 requirement_id [FK, UQ]
 assessed_by [FK: staff]
 恢复情况
 结论
 完成时间
}
entity "预约\nappointment" as appointment {
 id [PK]
 --
 patient_id [FK]
 dentist_id [FK: staff]
 created_by [FK: staff]
 起始时间
 结束时间
}
visit ||--o{ followup_requirement
followup_requirement ||--o{ contact_history
followup_requirement ||--o| clinical_assessment
appointment |o--o{ followup_requirement
appointment |o--o{ contact_history
appointment ||--o| visit
@enduml
