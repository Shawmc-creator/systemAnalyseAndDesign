@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SimSun
skinparam defaultFontSize 17
skinparam ArrowColor black
skinparam EntityBackgroundColor white
skinparam PackageBackgroundColor white
skinparam PackageBorderColor black
skinparam nodesep 28
skinparam ranksep 42
hide circle
left to right direction
package "连锁与门店授权" as g0 {
entity "连锁诊所\nclinic_chain" as clinic_chain {
* id <<PK>>
}
entity "门店\nclinic_branch" as clinic_branch {
* id <<PK>>
* chain_id <<FK>>
}
entity "门店岗位授权\nbranch_staff_role" as branch_staff_role {
* id <<PK>>
* branch_id, staff_id <<FK>>
}
entity "跨店病历查阅授权\ncross_branch_record_access" as cross_branch_record_access {
* id <<PK>>
* dentist_id, patient_id, visit_id <<FK>>
* source_branch_id, target_branch_id <<FK>>
}
clinic_chain ||--o{ clinic_branch
clinic_branch ||--o{ branch_staff_role
}
package "身份与接诊" as g1 {
entity "患者\npatient" as patient {
* id <<PK>>
  created_branch_id <<FK>>
}
entity "职员\nstaff" as staff {
* id <<PK>>
}
entity "患者资料变更\npatient_change" as patient_change {
* id <<PK>>
* operator_branch_id <<FK>>
}
entity "职员账号\nuser_account" as user_account {
* id <<PK>>
}
entity "诊椅\ndental_chair" as dental_chair {
* id <<PK>>
* branch_id <<FK>>
}
entity "日期安排\ndated_schedule" as dated_schedule {
* id <<PK>>
* branch_id <<FK>>
}
entity "安排变更\nschedule_change" as schedule_change {
* id <<PK>>
}
entity "接诊占用\nresource_occupancy" as resource_occupancy {
* id <<PK>>
}
entity "预约\nappointment" as appointment {
* id <<PK>>
* branch_id <<FK>>
}
entity "预约变更\nappointment_change" as appointment_change {
* id <<PK>>
}
entity "就诊\nvisit" as visit {
* id <<PK>>
* branch_id <<FK>>
}
entity "诊疗设备\nclinical_equipment" as clinical_equipment {
* id <<PK>>
* branch_id <<FK>>
}
entity "资源停用时段\nresource_block" as resource_block {
* id <<PK>>
}
entity "设备占用\nequipment_occupancy" as equipment_occupancy {
* id <<PK>>
}
}
package "病历与诊疗文书" as g2 {
entity "健康版本\nhealth_version" as health_version {
* id <<PK>>
  source_visit_id <<FK>>

  patient_id -> patient
  source_visit_id -> visit
}
entity "健康条目\nhealth_item" as health_item {
* id <<PK>>
}
entity "健康复核\nhealth_review" as health_review {
* id <<PK>>

  visit_id -> visit
}
entity "病历\nclinical_record" as clinical_record {
* id <<PK>>

  visit_id -> visit
}
entity "检查所见\nclinical_finding" as clinical_finding {
* id <<PK>>
}
entity "病历补充\nrecord_addendum" as record_addendum {
* id <<PK>>
}
entity "诊疗文件\nclinical_document" as clinical_document {
* id <<PK>>
* branch_id <<FK>>

  patient_id -> patient
  plan_version_id -> plan_version
  visit_id -> visit
}
entity "文件版本\ndocument_version" as document_version {
* id <<PK>>
}
entity "处方\nprescription" as prescription {
* id <<PK>>

  patient_id -> patient
  visit_id -> visit
}
entity "处方明细\nprescription_item" as prescription_item {
* id <<PK>>

  material_id -> material
  service_price_id -> service_price
}
entity "实际发药\ndispense_record" as dispense_record {
* id <<PK>>

  inventory_movement_id -> inventory_movement
}
entity "文件归属更正\ndocument_correction" as document_correction {
* id : INTEGER <<PK>>
* document_version_id : INTEGER <<FK>>
* corrected_document_version_id : INTEGER <<FK>>
* event_no : INTEGER
* event_type : TEXT
}
entity "处方审方历史\nprescription_review_history" as prescription_review_history {
* id : INTEGER <<PK>>
* prescription_id : INTEGER <<FK>>
* event_no : INTEGER
* event_type : TEXT
}
}
package "治疗方案与实际执行" as g3 {
entity "治疗方案\ntreatment_plan" as treatment_plan {
* id <<PK>>
* branch_id <<FK>>

  patient_id -> patient
}
entity "方案版本\nplan_version" as plan_version {
* id <<PK>>

  source_visit_id -> visit
}
entity "方案项目\nplan_item" as plan_item {
* id <<PK>>
}
entity "患者决定\npatient_decision" as patient_decision {
* id <<PK>>
}
entity "患者决定—方案项目\ndecision_plan_item" as decision_plan_item {
* decision_id : INTEGER <<PK,FK>>
* plan_item_id : INTEGER <<PK,FK>>
}
entity "患者决定—确认原件\ndecision_file_version" as decision_file_version {
* decision_id : INTEGER <<PK,FK>>
* document_version_id : INTEGER <<PK,FK>>

  document_version_id -> document_version
}
entity "诊疗执行\ntreatment_execution" as treatment_execution {
* id <<PK>>
* branch_id <<FK>>

  service_id -> service
  visit_id -> visit
}
}
package "价目、账单与收款" as g4 {
entity "患者资金\npatient_funds" as patient_funds {
* id <<PK>>
* branch_id <<FK>>

  patient_id -> patient
}
entity "收费项目\nservice" as service {
* id <<PK>>
}
entity "价目\nservice_price" as service_price {
* id <<PK>>
* branch_id <<FK>>
}
entity "应收账目\nbill" as bill {
* id <<PK>>
* branch_id <<FK>>

  patient_id -> patient
}
entity "应收项目\nbill_item" as bill_item {
* id <<PK>>

  dispense_record_id -> dispense_record
  quote_item_id -> quote_item
  treatment_execution_id -> treatment_execution
}
entity "患者付款\npatient_payment" as patient_payment {
* id <<PK>>
* branch_id <<FK>>

  quote_id -> treatment_quote
}
entity "付款分配\npayment_allocation" as payment_allocation {
* id <<PK>>

  fee_request_id -> fee_request
}
entity "预付抵扣\nprepayment_offset" as prepayment_offset {
* id <<PK>>

  fee_request_id -> fee_request
}
entity "电子支付单\npayment_order" as payment_order {
* id <<PK>>
* branch_id <<FK>>
}
entity "收退款核对\npayment_reconciliation" as payment_reconciliation {
* id <<PK>>
* branch_id <<FK>>

  patient_refund_id -> patient_refund
}
entity "价目审核历史\nservice_price_history" as service_price_history {
* id : INTEGER <<PK>>
* service_price_id : INTEGER <<FK>>
* event_no : INTEGER
* event_type : TEXT
}
}
package "费用更正与退费" as g5 {
entity "费用申请\nfee_request" as fee_request {
* id <<PK>>
* branch_id <<FK>>

  bill_id -> bill
  patient_funds_id -> patient_funds
  patient_payment_id -> patient_payment
}
entity "费用调整\nfee_adjustment" as fee_adjustment {
* id <<PK>>

  bill_id -> bill
}
entity "调整项目\nfee_adjustment_item" as fee_adjustment_item {
* id <<PK>>

  bill_item_id -> bill_item
}
entity "退款办理\npatient_refund" as patient_refund {
* id <<PK>>
* branch_id <<FK>>

  patient_funds_id -> patient_funds
  patient_payment_id -> patient_payment
}
entity "费用申请历史\nfee_request_history" as fee_request_history {
* id : INTEGER <<PK>>
* fee_request_id : INTEGER <<FK>>
* event_no : INTEGER
* event_type : TEXT
}
}
package "复诊与随访" as g6 {
entity "诊后要求\nfollowup_requirement" as followup_requirement {
* id <<PK>>
* source_branch_id <<FK>>
* responsible_branch_id <<FK>>

  patient_id -> patient
  source_plan_version_id -> plan_version
  source_visit_id -> visit
}
entity "联系经历\ncontact_history" as contact_history {
* id <<PK>>
* operator_branch_id <<FK>>

  appointment_id -> appointment
}
entity "临床评估\nclinical_assessment" as clinical_assessment {
* id <<PK>>
* assessment_branch_id <<FK>>

  visit_id -> visit
}
entity "诊后要求历史\nfollowup_history" as followup_history {
* id : INTEGER <<PK>>
* followup_requirement_id : INTEGER <<FK>>
* event_no : INTEGER
* event_type : TEXT
}
}
package "材料与库存" as g7 {
entity "材料\nmaterial" as material {
* id <<PK>>
}
entity "材料批次\nmaterial_batch" as material_batch {
* id <<PK>>
* branch_id <<FK>>
}
entity "批次变更\nbatch_change" as batch_change {
* id <<PK>>
}
entity "存放位置\nstock_location" as stock_location {
* id <<PK>>
* branch_id <<FK>>
}
entity "批次存量\nbatch_stock" as batch_stock {
* id <<PK>>
}
entity "库存变动\ninventory_movement" as inventory_movement {
* id <<PK>>

  purchase_receipt_item_id -> purchase_receipt_item
}
entity "实际用料\nmaterial_usage" as material_usage {
* id <<PK>>

  visit_id -> visit
}
entity "盘点核实\nstock_count" as stock_count {
* id <<PK>>
}
entity "盘点核实历史\nstock_count_history" as stock_count_history {
* id : INTEGER <<PK>>
* stock_count_id : INTEGER <<FK>>
* event_no : INTEGER
* event_type : TEXT
}
}
package "基础采购与验收" as g8 {
entity "供应商\nsupplier" as supplier {
* id <<PK>>
}
entity "采购\npurchase_order" as purchase_order {
* id <<PK>>
* branch_id <<FK>>
}
entity "采购项目\npurchase_order_item" as purchase_order_item {
* id <<PK>>

  material_id -> material
}
entity "验收\npurchase_receipt" as purchase_receipt {
* id <<PK>>
}
entity "验收项目\npurchase_receipt_item" as purchase_receipt_item {
* id <<PK>>

  material_batch_id -> material_batch
  stock_location_id -> stock_location
}
entity "验收项目历史\nreceipt_item_history" as receipt_item_history {
* id : INTEGER <<PK>>
* purchase_receipt_item_id : INTEGER <<FK>>
 inventory_movement_id : INTEGER <<FK,UK>>
* event_no : INTEGER
* event_type : TEXT

  inventory_movement_id -> inventory_movement
}
}
package "门诊医保与结算款" as g9 {
entity "医保身份核验\ninsurance_identity" as insurance_identity {
* id <<PK>>
* branch_id <<FK>>

  patient_id -> patient
}
entity "医保项目对应\ninsurance_item_mapping" as insurance_item_mapping {
* id <<PK>>
* branch_id <<FK>>

  material_id -> material
  service_id -> service
}
entity "医保就诊办理\ninsurance_case" as insurance_case {
* id <<PK>>
* branch_id <<FK>>

  bill_id -> bill
  patient_id -> patient
  visit_id -> visit
}
entity "医保费用明细\ninsurance_fee" as insurance_fee {
* id <<PK>>

  bill_item_id -> bill_item
}
entity "医保结算\ninsurance_settlement" as insurance_settlement {
* id <<PK>>
}
entity "医保撤销办理\ninsurance_reversal" as insurance_reversal {
* id <<PK>>

  fee_request_id -> fee_request
}
entity "医保结算款收付\ninsurance_fund_receipt" as insurance_fund_receipt {
* id <<PK>>
}
entity "医保预结算历史\ninsurance_preestimate_history" as insurance_preestimate_history {
* id : INTEGER <<PK>>
* insurance_case_id : INTEGER <<FK>>
 request_id : INTEGER <<FK>>
* bill_id : INTEGER <<FK>>
* identity_id : INTEGER <<FK>>
* event_no : INTEGER
* event_type : TEXT

  bill_id -> bill
}
}
package "独立报价" as g10 {
entity "治疗报价单\ntreatment_quote" as treatment_quote {
* id <<PK>>
* branch_id <<FK>>

  patient_id -> patient
  treatment_plan_id -> treatment_plan
}
entity "报价版本\nquote_version" as quote_version {
* id <<PK>>

  source_plan_version_id -> plan_version
}
entity "报价明细\nquote_item" as quote_item {
* id <<PK>>

  plan_item_id -> plan_item
  service_id -> service
  service_price_id -> service_price
}
entity "报价确认\nquote_decision" as quote_decision {
* id <<PK>>
}
}
