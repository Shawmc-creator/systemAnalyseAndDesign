@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SimSun
skinparam defaultFontSize 19
skinparam ArrowColor black
skinparam ClassBackgroundColor white
skinparam ActorBackgroundColor white
skinparam sequenceMessageAlign center
skinparam classAttributeIconSize 0
left to right direction
allowmixing
actor "获授权负责人" as M
boundary "诊所基础管理边界" as B
control "维护基础资料与账号控制" as C
class "职员" as S <<entity>> {
 职员编号、姓名、在岗期间
 --
 核对在岗期间()
 建立职员资料()
 核实任职及授权依据()
}
class "职员账号" as A <<entity>> {
 个人登录名、启停状态、授权版本
 /获准岗位集合
 --
 核对账号可用性()
 核验办理授权()
 建立个人账号()
 停用或恢复账号()
}
class "诊椅" as H <<entity>> {
 所属门店、诊椅编号、名称、有效期间
 --
 核对资源有效期间()
 登记诊椅()
 核对退役条件()
 确认诊椅退役()
}
class "门店岗位授权" as RG <<entity>> {
 岗位、有效期间及撤销依据
 --
 核对门店岗位权限()
 授予或撤销()
}
class "跨店病历查阅授权" as AUTH <<entity>> {
 患者、原就诊及授权范围
 --
 登记或撤销授权及依据()
 核对授权范围()
}
M -- B
B --> C
C ..> S
C ..> A
C ..> H
C ..> RG
C ..> AUTH
S "1" -- "0..1" A : 使用个人账号
note bottom of A
获准岗位为任职与授权的派生结果；
兼岗保留同一职员身份。
end note
@enduml
