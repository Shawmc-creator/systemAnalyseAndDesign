@startuml
hide footbox
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SimSun
skinparam defaultFontSize 17
skinparam dpi 200
skinparam maxMessageSize 180
skinparam sequence {
 ArrowColor black
 ArrowFontSize 17
 LifeLineBorderColor black
 LifeLineBackgroundColor white
 ParticipantBorderColor black
 ParticipantBackgroundColor white
 GroupBorderColor black
 GroupBackgroundColor white
 GroupHeaderFontSize 16
 ParticipantFontSize 16
 ReferenceBackgroundColor white
 ReferenceBorderColor black
}
skinparam NoteBackgroundColor white
skinparam NoteBorderColor black
actor "前台" as A #white
boundary "<u>:前台接口</u>" as B #white
control "<u>:维护预约及</u>\n<u>接诊安排控制</u>" as K #white
participant "<u>:患者</u>" as P
participant "<u>:职员</u>" as S
participant "<u>:预约</u>" as R
participant "<u>:接诊时段</u>" as T
A -> B : 新增预约()
B --> A : 提示选定患者（步骤1-2）
A -> B : 查询患者(姓名或电话)
B -> K : 查找患者候选()
K -> P : 提供身份核对候选()
P --> K : 患者编号、姓名及电话
K --> B : 候选或无档案结果
B --> A : 展示待核对身份
opt 尚无档案（2a）
 ref over A,B
  通过UC-08建档后返回，取得患者编号。
 end ref
end
A -> B : 提交选定患者与时段
activate B
B -> B : 检查输入格式()
B -> K : 检查预约安排(预约内容)
activate K
K -> P : 核对患者编号()
activate P
P --> K : 预约患者
deactivate P
K -> T : 提供时段及确认依据()
activate T
T --> K : 发布时段、确认牙医及时间
deactivate T
K -> S : 校验牙医及确认人()
activate S
S --> K : 人员及依据是否合法
deactivate S
K -> R : 检查患者与牙医冲突()
activate R
R --> K : 安排是否合法及冲突时段
deactivate R
K --> B : 待保存安排或校验问题
deactivate K
B --> A : 展示校验结果（步骤3-4）
deactivate B
opt 校验通过，前台核对后确认
A -> B : 确认预约()
activate B
B -> K : 维护预约及接诊安排()
activate K
critical 冲突复查与保存同时完成
K -> R : 保存预约(安排、前台)
activate R
R -> R : 检查时段冲突()
R --> K : 新预约或冲突拒绝结果
deactivate R
end
K --> B : 本次保存结果
deactivate K
B --> A : 反馈编号及结果（步骤5-6）
deactivate B
end
@enduml
