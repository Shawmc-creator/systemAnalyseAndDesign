@startuml
hide footbox
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SimSun
skinparam defaultFontSize 17
skinparam dpi 200
skinparam maxMessageSize 125
skinparam sequence {
 ArrowColor black
 ArrowFontSize 17
 LifeLineBorderColor black
 LifeLineBackgroundColor white
 ParticipantBorderColor black
 ParticipantBackgroundColor white
 GroupBorderColor black
 GroupBackgroundColor white
 GroupHeaderFontSize 16
 ParticipantFontSize 16
 ReferenceBackgroundColor white
 ReferenceBorderColor black
}
skinparam NoteBackgroundColor white
skinparam NoteBorderColor black
actor "牙医" as A #white
boundary "<u>:牙医接口</u>" as B #white
control "<u>:确认诊疗</u>\n<u>项目控制</u>" as K #white
participant "<u>:就诊</u>" as V
participant "<u>:诊疗确认</u>" as C
participant "<u>:诊疗明细</u>" as I
participant "<u>:方案项目</u>" as Q
A -> B : 选择就诊(就诊编号)
activate B
B -> K : 取得本人接诊记录()
activate K
K -> V : 核对接诊归属(当前牙医)
activate V
V --> K : 本次就诊或拒绝原因
deactivate V
K --> B : 当前就诊资料
deactivate K
B --> A : 展示患者及已有明细（步骤1-2）
deactivate B
opt 本人接诊且尚未结清
 A -> B : 提交完整实际明细（步骤3）
 activate B
 B -> B : 检查字段格式()
 B -> K : 检查实际项目及方案依据()
 activate K
 K -> V : 核对未结清及当前版本()
 activate V
 V --> K : 当前有效确认及替换依据
 deactivate V
 K -> C : 校验拟生效完整集合()
 activate C
 loop 每条实际明细
  C -> I : 校验项目、牙位、数量及完成时间()
  activate I
  alt 关联方案项目
   I -> Q : 核对本次归属、项目及牙位()
   activate Q
   Q -> Q : 判断患者已同意()
   Q -> Q : 校验拟生效数量(完整集合、被替换版本)
   Q --> I : 方案允许或拒绝原因
   deactivate Q
  else 方案外实际项目
   I -> I : 核对方案外原因及患者确认事实()
  end
  I --> C : 明细及方案校验结果
  deactivate I
 end
 C -> C : 按项目、牙位及一致依据合并重复明细()
 C --> K : 待确认完整集合或问题
 deactivate C
 K --> B : 校验结果
 deactivate K
 B --> A : 核对实际项目（步骤4）
 deactivate B
newpage
 opt 完整集合合法，牙医确认
  A -> B : 确认项目(当前版本)
  activate B
  B -> K : 确认诊疗项目()
  activate K
  critical 最后核验与保存同时生效
   K -> V : 确认诊疗(完整集合、当前版本)
   activate V
   V -> V : 复核归属、未结清及最新版本()
   V -> C : 复核明细及方案数量()
   activate C
   ref over C,Q
    再次执行前页校验，旧版本不重复累计。
   end ref
   alt 全部校验仍有效
    V -> C : 保存新确认(完整集合、确认时点)
    loop 每条拟生效明细
     C -> I : 保存实际完成时间及方案关联()
     activate I
     ref over C,I
      项目有效性及计价协作见辅助计价图。
      已有同项目明细继承原时点和价目。
     end ref
     I --> C : 实际明细及计价依据或缺价标记
     deactivate I
    end
    C --> V : 新确认版本
    V -> V : 采用新版本，替换原有效数量依据()
   else 版本或业务条件已变化
    V -> V : 拒绝保存并保持原确认()
   end
   deactivate C
   V --> K : 新版本或拒绝结果
   deactivate V
  end
  K --> B : 本次结果
  deactivate K
  B --> A : 反馈确认版本及费用依据（步骤5-6）
  deactivate B
 end
end
@enduml
