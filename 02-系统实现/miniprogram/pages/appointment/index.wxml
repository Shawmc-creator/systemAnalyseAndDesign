<view class="content">
  <view class="masthead">
    <image class="brand-mark" src="/assets/qinghe.png" mode="aspectFit" />
    <view>
      <text class="page-title">青禾牙科预约</text>
      <text class="help-text">{{modeLabel}}</text>
      <text wx:if="{{patientName}}" class="patient-name">当前患者 · {{patientName}}</text>
      <text wx:if="{{patientRecordNo}}" class="help-text">患者档案号 {{patientRecordNo}}</text>
    </view>
  </view>

  <view wx:if="{{!signedIn}}" class="section empty">
    <text class="section-title">患者登录</text>
    <text class="help-text">{{error || '登录后可预约，并查看自己的预约记录。'}}</text>
    <button class="action retry" bindtap="login" loading="{{loading}}" disabled="{{loading}}">{{online ? '微信登录' : '登录演示账号'}}</button>
  </view>
  <view wx:elif="{{loading}}" class="section empty">正在读取预约安排…</view>
  <view wx:elif="{{!branches.length}}" class="section empty">
    <text>{{error || '目前暂无可选门店。'}}</text>
    <button class="secondary retry" bindtap="refreshOptions">重新读取</button>
  </view>
  <block wx:else>
    <view class="section">
      <text class="section-title">选择门店</text>
      <view class="branches">
        <button wx:for="{{branches}}" wx:key="id" class="branch {{branchId === item.id ? 'branch-active' : ''}}" data-id="{{item.id}}" bindtap="chooseBranch">
          <text class="branch-name">{{item.name}}</text>
          <text class="choice">{{branchId === item.id ? '已选' : '选择'}}</text>
        </button>
      </view>
    </view>

    <view class="section">
      <text class="section-title">1. 选择日期</text>
      <view class="calendar">
        <view class="calendar-nav">
          <button class="secondary" aria-label="上个月" bindtap="changeMonth" data-delta="-1" disabled="{{!previousMonth}}">‹</button>
          <text>{{monthTitle}}</text>
          <button class="secondary" aria-label="下个月" bindtap="changeMonth" data-delta="1" disabled="{{!nextMonth}}">›</button>
        </view>
        <view class="calendar-grid weekdays">
          <text wx:for="{{weekdays}}" wx:key="*this">{{item}}</text>
        </view>
        <view class="calendar-grid">
          <block wx:for="{{days}}" wx:key="date">
            <button wx:if="{{item.day}}" class="day {{date === item.date ? 'pill-active' : ''}}" disabled="{{!item.available}}"
              aria-label="{{item.date}}" data-date="{{item.date}}" bindtap="chooseDate">{{item.day}}</button>
            <view wx:else></view>
          </block>
        </view>
      </view>
      <text class="help-text calendar-note">{{hasAvailability ? '高亮日期还有号源。' : '该门店暂无可约日期，请切换门店。'}}</text>
    </view>

    <view class="section">
      <text class="section-title">2. 选择时间</text>
      <view wx:if="{{slots.length}}" class="slots">
        <button wx:for="{{slots}}" wx:key="*this" class="slot {{time === item ? 'pill-active' : ''}}" data-time="{{item}}" bindtap="chooseTime">{{item}}</button>
      </view>
      <text wx:else class="help-text">请先选择日期。</text>
    </view>

    <view class="section">
      <text class="section-title">3. 选择医生</text>
      <view wx:if="{{doctors.length}}" class="branches">
        <button wx:for="{{doctors}}" wx:key="id" class="branch {{chosenDoctor === item.id ? 'branch-active' : ''}}" data-id="{{item.id}}" bindtap="chooseDoctor">
          <text class="branch-name">{{item.dentist}}</text><text class="choice">{{chosenDoctor === item.id ? '已选' : '可预约'}}</text>
        </button>
      </view>
      <text wx:else class="help-text">请先选择时间。</text>
    </view>

    <view class="section booking-action">
      <picker range="{{reasons}}" value="{{reasonIndex < 0 ? 0 : reasonIndex}}" bindchange="chooseReason">
        <view class="purpose"><text>4. 就诊目的</text><text class="purpose-value">{{reasonIndex < 0 ? '请选择' : reasons[reasonIndex]}} ›</text></view>
      </picker>
      <text wx:if="{{time}}" class="summary">{{branchName}} · {{date}} {{time}}</text>
      <text wx:if="{{error}}" class="error">{{error}}</text>
      <button class="action" disabled="{{!chosenDoctor || reasonIndex < 0 || saving}}" loading="{{saving}}" bindtap="submitBooking">确认预约</button>
    </view>
  </block>
</view>
